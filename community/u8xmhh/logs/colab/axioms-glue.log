                                (OAI.PowerSaving.RAM.bundle cl) (fun i => OAI.PowerSaving.RAM.givenBits cl (k i) (v i))
                                (fun i =>
                                  (OAI.PowerSaving.Binary.bits (k i)).tape (OAI.PowerSaving.Binary.ripple (k i) (v i)))
                                fun i => 2 ^ k i * OAI.PowerSaving.envelope z (k i)
