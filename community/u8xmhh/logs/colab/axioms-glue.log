  Fintype.card H = 9 →
    ∀ (S : OAI.PowerSaving.XHost.HostSched Sl T),
      S.fits I.ent →
        ∀ (u W : ℕ),
          73 = u →
            64 * Fintype.card T + S.nb = W →
              1 ≤ W →
                ∀ (U : List (ℕ × ℕ)),
                  (∀ (φ : ℕ → ℝ), OAI.PowerSaving.XHost.unitPriceHost I S φ = OAI.PowerSaving.Binary.listCost φ U) →
                    ∀ (s : ℕ) (z : ℝ),
                      0 ≤ z →
                        z ≤ 1 →
                          (2 ^ s - 1) * OAI.PowerSaving.BlockAccounting.moment u z U +
                                ↑W *
                                  (OAI.PowerSaving.BlockAccounting.T u z (u - 1) 1 +
                                    OAI.PowerSaving.BlockAccounting.T u z 1 1) <
                              2 ^ s * ↑W →
