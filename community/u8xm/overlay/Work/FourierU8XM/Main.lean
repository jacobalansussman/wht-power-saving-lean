namespace OAI

/-!
Exact uniform Fourier transforms and convolution.

The construction formalizes the exact arithmetic algorithms of
*An explicit power saving for the exact discrete Fourier transform* (OpenAI).
The finite phase network originates in the complex construction of
*Integer multiplication below n log n*.

`transform_mainU8XM` and `convolution_mainU8XM` give fixed finite RAM programs, including
preparation and index work, polynomial storage bounds, and a canonical root whose
order is computed from the input length. Each includes the paper exponent, decimal
power saving, and little-o bound. The `_order` variants also specify the root order.

The implementation uses a smaller concrete tensor network (32 binary coordinates
per factor, 4060 triples, and a `2^50` role envelope) with a stronger saving that
implies the stated paper constants. The general rational-algebra extraction,
symbolic certificate search, circuit printer, and bounded-printer uniformization
from the synthesis appendix are outside this formalization.
-/
namespace PowerSaving
open RAM Bench Selection Filter Asymptotics Real
noncomputable section
namespace Skies

lemma multiplier_rangeU8XM : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltU8XM : theta < 1 := by
  have h := multiplier_rangeU8XM
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaU8XM : alphaU8XM < theta := by
  let d : ℝ := 13868857/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeU8XM.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minU8XM
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeU8XM : alphaU8XM < decimalExponentU8XM ∧ decimalExponentU8XM < 1 := by
  norm_num [decimalExponentU8XM,alphaU8XM]

def speedU8XM (v : ℝ) (n : ℕ) := (n:ℝ)*(TmU8XM n)^v

lemma flight_littleU8XM {v : ℝ} (h : alphaU8XM < v) :
    flightU8XM =o[atTop] speedU8XM v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8XM.eventually_ge_atTop 1,dwarfU8XM TtopU8XM 2
    (p:=v-alphaU8XM) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8XM n := by linarith
  change ‖(n:ℝ)*TmU8XM n^alphaU8XM*QmU8XM n^2‖ ≤ c*‖(n:ℝ)*TmU8XM n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmU8XM n^alphaU8XM)*(c*TmU8XM n^(v-alphaU8XM)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmU8XM n^alphaU8XM*TmU8XM n^(v-alphaU8XM))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaU8XM + (v-alphaU8XM)=v by ring] -- a+(v-a)

lemma speed_littleU8XM {u v : ℝ} (h : u < v) :
    speedU8XM u =o[atTop] speedU8XM v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8XM.eventually_ge_atTop 1,dwarfU8XM TtopU8XM 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8XM n := by linarith
  change ‖(n:ℝ)*TmU8XM n^u‖ ≤ c*‖(n:ℝ)*TmU8XM n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmU8XM n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmU8XM n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmU8XM n^u)*(c*TmU8XM n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmU8XM n^u*TmU8XM n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleU8XM : decimalTimeU8XM =o[atTop] nlogn := by
  have H := speed_littleU8XM decimal_rangeU8XM.2
  have h : speedU8XM 1 = nlogn := funext fun n => by rw [speedU8XM,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperU8XM : speedU8XM theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopU8XM.eventually_ge_atTop 1,QtopU8XM.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmU8XM n := by linarith
  have he' : 0<QmU8XM n := by linarith
  change ‖(n:ℝ)*TmU8XM n^theta‖ ≤ 1*‖(n:ℝ)*TmU8XM n^theta*QmU8XM n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltU8XM])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundU8XM {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationU8XM) :
    TimeBoundsU8XM (lunchU8XM a b N) := by
  have H := lunch_bigU8XM a b h
  have hp := H.trans_isLittleO (flight_littleU8XM alpha_thetaU8XM)
  have hd := H.trans_isLittleO (flight_littleU8XM decimal_rangeU8XM.1)
  have ht : (fun n => (lunchU8XM a b N n:ℝ)) =O[atTop] decimalTimeU8XM := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperU8XM,ht,ht.trans_isLittleO decimal_littleU8XM⟩

end Skies

/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderU8XM : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsU8XM W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneU8XM
  exact ⟨o,s,lunchU8XM a b id,hp,Skies.time_boundU8XM (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderU8XM : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsU8XM W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothU8XM
  have h (n : ℕ) : n ≤ stretchU8XM n ∧ stretchU8XM n ≤ 2*n := by unfold stretchU8XM; omega
  exact ⟨o,s,lunchU8XM a b stretchU8XM,hp,Skies.time_boundU8XM h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posU8XM hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 13868856/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentU8XM = 1 - 13868856/10^10`
(Work/FourierU8XM/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_U8XMx`: both
follow from one kernel program, `RAM.hillsU8XM_program` (Work/FourierU8XM/Seam.lean). -/
theorem transform_mainU8XM : DFTGoalU8XM :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderU8XM
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainU8XM : ConvGoalU8XM :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderU8XM
  ⟨o,s,W,h,g⟩

