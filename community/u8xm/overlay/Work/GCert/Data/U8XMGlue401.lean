/-!
# (key: k-combine) the EXIT-FRAME invocation package with MUTABLE SOURCES and the bank schedule of `GXD.U8XM`
Generated by k-combine's generate_global_lean_xz.py (on k-lower's generate_global_lean_x.py, itself on Ryan Shea's
C588Glue401 / Nil Mamano's G5 glue).  `ginvX` is k-combine's `GXD.ginvXOfZ` (Work/KMX/GlueXZ.lean: `GLabXZ` over
x-mutable's gauged mutable-source scalar half) on the kernel checks of this certificate: scalar half `scalOKZ`
(sources mutable), E7 `echk<j>_ok` (`GS.eCheckZ`), label half `validX` (k-lower's exit-aware end check `endKX`), the
three exit conditions `exitRC` (zero checks `GS.zCheckZ` on the y-free twin, `Gen.U8XMZOK`).
`ginv := ginvX.toE'` is x-exit-lean's reduction (XExit/Pack) to Shea's gauged package: same price; the bank loads are
the exit residuals.
-/

set_option maxRecDepth 100000
namespace GXD.U8XM
open GXD OAI.PowerSaving OAI.PowerSaving.CB
noncomputable section

/-- the E7 batches: parameters and gauge registers -/
def es : List (GS.SPar × List Nat) := [(⟨10, 8, 8, 16, 8⟩, glb0), (⟨10, 8, 8, 16, 8⟩, glb1), (⟨10, 8, 8, 16, 8⟩, glb2)]

theorem es_gl : es.flatMap Prod.snd = gl := by first | rfl | decide

theorem es_ok : ∀ e ∈ es, GS.eCheckZ raw e.1 e.2 = true := by
  intro e he
  unfold es at he
  rcases List.mem_cons.mp he with h | he
  · subst h; exact echk0_ok
  rcases List.mem_cons.mp he with h | he
  · subst h; exact echk1_ok
  rcases List.mem_cons.mp he with h | he
  · subst h; exact echk2_ok
  exact absurd he List.not_mem_nil

/-- **the exit-frame invocation package** of the certificate -/
def ginvX : OAI.PowerSaving.XEX.GInvX (Fin aux.p.h) (Fin raw.v) (Fin raw.R) (Fin raw.ret.length) :=
  GXD.ginvXOfZ raw scalOKZ es es_ok aux el (es_gl.symm ▸ validX) exitRC.1 exitRC.2.1 exitRC.2.2

/-- **the gauged invocation package** (x-exit-lean's reduction `GInvX.toE'`) -/
def ginv : GX.GInvE (Fin aux.p.h) (Fin raw.v) (Fin raw.R) (Fin raw.ret.length) := ginvX.toE'

theorem h9 : Fintype.card (Fin aux.p.h) = 9 := by rw [Fintype.card_fin]; rfl

/-- its price is the invocation price `invPrice` (kernel counts) -/
theorem ginv_cost (φ : ℕ → ℝ) : ginv.cost φ = invPrice φ := by
  have h5 : ∀ k : Fin raw.ret.length,
      bcost φ (GLab.cdim (aux.p.tab.get (aux.SA.get (GXD.reg raw k)))) = bcost φ 8 :=
    fun k => congrArg (bcost φ) (cen_dim _ (GXD.reg_mem raw k))
  show ginvX.cost φ = _
  rw [ginvX, GXD.ginvXOfZ_cost, Finset.sum_congr rfl (fun k _ => h5 k), Finset.sum_const, Finset.card_univ,
    nsmul_eq_mul, Fintype.card_fin, ← inv_cost φ, show raw.ret.length = 8 from by decide]
  norm_num [bcost]
  try rfl

/-- the bank schedule of the certificate (tables `Gen.U8XMSched`, checker `GX.schedK` of DFT New Sums) -/
def sched : GX.BankSched (Fin raw.R) := GX.BankSched.ofTab 3771 raw.R schedRows schedPad schedRes sched_ok

/-- the EXIT residuals of the table (start and end states of the label check) -/
theorem res_ok : ∀ q : Fin raw.R, Bool.rec (motive := fun _ => Nat)
    (aux.p.h - GLab.cdim (aux.p.tab.get (aux.S0.get (2 * raw.v + q.val))))
    (GLab.cdim (aux.p.tab.get (aux.SF.get (2 * raw.v + q.val)))
      - GLab.cdim (aux.p.tab.get (aux.S0.get (2 * raw.v + q.val))))
    (GLab.memK (2 * raw.v + q.val) el) = schedRes.getD q.val 0 := by
  decide +kernel

theorem hent : ∀ q : Fin raw.R, Fintype.card (Fin aux.p.h) - (ginv.ent q).dim = schedRes.getD q.val 0 := fun q => by
  show Fintype.card (Fin aux.p.h) - (ginvX.entS q).dim = _
  rw [ginvX.entS_hd q]
  exact (GXD.ginvXOfZ_res raw scalOKZ es es_ok aux el (es_gl.symm ▸ validX) exitRC.1 exitRC.2.1 exitRC.2.2 q).trans
    (res_ok q)

theorem fitsS : sched.fits ginv.ent := GX.BankSched.ofTab_fits _ _ _ _ _ sched_ok ginv.ent hent

theorem width : 64 * Fintype.card (Fin raw.v) + sched.nb = 10939 := by
  rw [Fintype.card_fin, sched, GX.BankSched.ofTab_nb, raw_v]

theorem pad_price (φ : ℕ → ℝ) : ∑ b, bcost φ (sched.pad b) = BridgeRate.U8XM.padPrice φ := by
  rw [sched, GX.BankSched.ofTab_padPrice, GXD.rcost_wsumK φ schedPad 27 rankBoundP]
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, rankP0_ok, rankP1_ok, rankP2_ok, rankP3_ok, rankP4_ok, rankP5_ok, rankP6_ok, rankP7_ok, rankP8_ok, rankP9_ok, rankP10_ok, rankP11_ok, rankP12_ok, rankP13_ok, rankP14_ok, rankP15_ok, rankP16_ok, rankP17_ok, rankP18_ok, rankP19_ok, rankP20_ok, rankP21_ok, rankP22_ok, rankP23_ok, rankP24_ok, rankP25_ok, rankP26_ok, rankP27_ok]
  unfold BridgeRate.U8XM.padPrice
  norm_num [bcost]

/-- the unit price identity of the PR #401 unit (`GX.unitPrice401` shape) -/
theorem price (φ : ℕ → ℝ) : 72 * ginv.cost φ + (Fintype.card (Fin raw.v) : ℝ) * GX.bankPrice377 φ
    + ∑ b, bcost φ (sched.pad b) = BridgeRate.U8XM.unitPrice φ := by
  rw [ginv_cost, pad_price, Fintype.card_fin, raw_v]
  unfold BridgeRate.U8XM.unitPrice BridgeRate.U8XM.invPrice invPrice
  push_cast
  ring

end
end GXD.U8XM
