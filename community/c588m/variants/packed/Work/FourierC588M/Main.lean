/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderC588M : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsC588M W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneC588M
  exact ⟨o,s,lunchC588M a b id,hp,Skies.time_boundC588M (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderC588M : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsC588M W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothC588M
  have h (n : ℕ) : n ≤ stretchC588M n ∧ stretchC588M n ≤ 2*n := by unfold stretchC588M; omega
  exact ⟨o,s,lunchC588M a b stretchC588M,hp,Skies.time_boundC588M h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posC588M hn)).2⟩⟩

