/-- `Z` private scratch roles in every call (e.g. `Z = Fin 91`, the zero buffers of a borrow word). -/
def XNet.addScratch (N : XNet H T Sl C α Γ nb nR) (Z : Type) [Fintype Z] [DecidableEq Z] :
    XNet H T Sl (C ⊕ Z) α Γ nb nR := N.reC Function.Embedding.inl

/-- the private scratch changes neither the host table nor the banks nor the host chains (the same fields). -/
lemma XNet.reC_host (N : XNet H T Sl C α Γ nb nR) (e : C ↪ C') :
    (N.reC e).hostAt = N.hostAt ∧ (N.reC e).tm = N.tm ∧ (N.reC e).hrem = N.hrem ∧ (N.reC e).pad = N.pad ∧
      (∀ ρ l q, ((N.reC e).Ic ρ l).ent q = (N.Ic ρ l).ent q) :=
  ⟨rfl, rfl, rfl, rfl, fun _ _ _ => rfl⟩

end Copy

section Cert
variable {H T Sl C C' α Γ : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C] [Fintype C'] [DecidableEq C'] [Fintype α] [DecidableEq α]
  [Fintype Γ] [DecidableEq Γ]
variable {nb nR : ℕ}

/-- **the private scratch is not paid**: the unit price is unchanged. -/
theorem XNet.unit_reC (N : XNet H T Sl C α Γ nb nR) (e : C ↪ C') (φ : ℕ → ℝ) : (N.reC e).unit φ = N.unit φ := rfl

theorem XNet.restU_reC (N : XNet H T Sl C α Γ nb nR) (e : C ↪ C') (φ : ℕ → ℝ) :
    (N.reC e).restU φ = N.restU φ := rfl

theorem XNet.restU_withIc (N : XNet H T Sl C α Γ nb nR) (Ic' : Fin nR → Fin 9 → GInvE H T Sl C)
    (htv : ∀ ρ l, (Ic' ρ l).tv = N.I.tv) (hent : ∀ ρ l, (Ic' ρ l).ent = (N.Ic ρ l).ent) (φ : ℕ → ℝ) :
    (N.withIc Ic' htv hent).restU φ = N.restU φ := rfl

/-- the price of the network with other invocations: the new calls and the same rest. -/
theorem XNet.unit_withIc (N : XNet H T Sl C α Γ nb nR) (Ic' : Fin nR → Fin 9 → GInvE H T Sl C)
    (htv : ∀ ρ l, (Ic' ρ l).tv = N.I.tv) (hent : ∀ ρ l, (Ic' ρ l).ent = (N.Ic ρ l).ent) (φ : ℕ → ℝ) :
    (N.withIc Ic' htv hent).unit φ = (∑ ρ : Fin nR, ∑ l : Fin 9, (Ic' ρ l).cost φ) + N.restU φ := by
  rw [XNet.unit_split, XNet.restU_withIc]
  rfl

/-- the certificate of the network with private scratch: the price of `N`. -/
theorem xnet_reC_certificate (N : XNet H T Sl C α Γ nb nR) (e : C ↪ C') :
    GCert α (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C' nR) (fun φ => (Fintype.card Γ : ℝ) * N.unit φ) :=
  xnet_certificate (N.reC e)

/-- **THE NETWORK THEOREM WITH TWO PROVIDERS AND PRIVATE SCRATCH**: call `(ρ, l)` runs provider `disp (ρ, l)`
(`0` = `I0`, `1` = `I1`) with its copies re-indexed by `e` (the copies outside the image of `e`: private scratch of
the call, e.g. zero buffers); the host table, banks and host chains are `N`'s; price
`|Γ| * (n0 * cost0 + n1 * cost1 + restU)`. -/
theorem xnet_disp_scratch_certificate (N : XNet H T Sl C α Γ nb nR) (e : C ↪ C') (I0 I1 : GInvE H T Sl C)
    (h : I1.tv = I0.tv) (disp : Fin nR × Fin 9 → Fin 2) (hN : ∀ ρ l, N.Ic ρ l = dispIc (Prov2.mk' I0 I1 h) disp ρ l) :
    GCert α (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C' nR)
      (fun φ => (Fintype.card Γ : ℝ) * ((nCalls disp 0 : ℝ) * I0.cost φ + (nCalls disp 1 : ℝ) * I1.cost φ
        + N.restU φ)) :=
  (xnet_reC_certificate N e).cast (fun φ => by rw [N.unit_disp2 I0 I1 h disp hN φ])

/-- the certificate of the network with other invocations of the same entrance labels. -/
theorem xnet_withIc_certificate (N : XNet H T Sl C α Γ nb nR) (Ic' : Fin nR → Fin 9 → GInvE H T Sl C)
    (htv : ∀ ρ l, (Ic' ρ l).tv = N.I.tv) (hent : ∀ ρ l, (Ic' ρ l).ent = (N.Ic ρ l).ent) :
    GCert α (Sum.inl : BLiveT Γ T nb nR → BRoleT Γ T nb C nR)
      (fun φ => (Fintype.card Γ : ℝ) * ((∑ ρ : Fin nR, ∑ l : Fin 9, (Ic' ρ l).cost φ) + N.restU φ)) :=
  (xnet_certificate (N.withIc Ic' htv hent)).cast (fun φ => by rw [N.unit_withIc Ic' htv hent φ])

end Cert
