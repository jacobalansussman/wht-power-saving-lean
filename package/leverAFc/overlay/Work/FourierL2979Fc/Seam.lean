/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL2979Fc : ℝ := 1 - 1788704501/(10:ℝ)^12

theorem alphaL2979Fc_pos : 0 < alphaL2979Fc := by norm_num [alphaL2979Fc]
theorem alphaL2979Fc_lt : alphaL2979Fc < 1 := by norm_num [alphaL2979Fc]

lemma envelope_monoL2979Fc (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL2979Fc {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL2979Fc (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL2979Fc)

lemma hillsL2979Fc_eq_envelope : hillsL2979Fc = envelope alphaL2979Fc := rfl

lemma hillsL2979Fc_pos (k : ℕ) : 1≤hillsL2979Fc k := envelope_pos alphaL2979Fc k

lemma hillsL2979Fc_mono {a b : ℕ} (h : a≤b) : hillsL2979Fc a ≤ hillsL2979Fc b := envelope_monoL2979Fc alphaL2979Fc alphaL2979Fc_pos.le h

lemma hillsL2979Fc_le (k : ℕ) : hillsL2979Fc k ≤ k+1 := envelope_le alphaL2979Fc alphaL2979Fc_lt.le k

lemma hillsL2979Fc_real (k : ℕ) : (hillsL2979Fc k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL2979Fc := envelope_real alphaL2979Fc alphaL2979Fc_pos.le k

/-! ## 3. The kernel program at `alphaL2979Fc` -/

namespace SeamL2979Fc
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL2979Fc = 1 - 1788704501/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L2979Fc (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL2979Fc (k i)) :=
  MX.L2979Fc.EngineStmt.lift MX.L2979Fc.engine cl m k v

end SeamL2979Fc

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL2979Fc`
(exponent `1 - 1788704501/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL2979Fc.engine_L2979Fc`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL2979Fc k` operations. -/
theorem hillsL2979Fc_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL2979Fc (k i)) :=
  SeamL2979Fc.engine_L2979Fc cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL2979Fc`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL2979Fc (z : ℝ) (hz : alphaL2979Fc ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL2979Fc_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL2979Fc hz (k i))

end RAM

