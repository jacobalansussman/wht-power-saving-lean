lemma target_posL2979Fc : 0 < targetExponentL2979Fc := by norm_num [targetExponentL2979Fc]
lemma target_lt_oneL2979Fc : targetExponentL2979Fc < 1 := by norm_num [targetExponentL2979Fc]
lemma fallback_lt_oneL2979Fc : fallbackExponentL2979Fc < 1 := by norm_num [fallbackExponentL2979Fc]
lemma target_lt_decimalL2979Fc : targetExponentL2979Fc < decimalExponent := by
