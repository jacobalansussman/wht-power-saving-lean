import Work.XHostT.TTab
import Work.XHostT.Data.S5.Whole

/-!
# (key: bridge-host-cross) The host table of hub PR #3945 as a Lean cross-replica host schedule

p-hostck's whole-table theorem `DS5.whole` (built on p-a3's kernel checker; data generated by p-hostck from p-own's
conversion of #3945's owner map: Dugongue, staged544 T360 terminal-gap fill; 360 replicas, 3,240 calls, 408 hosted
slots per call, 1,321,920 hosted slots) through `schedOfTabOK`: a `HostSchedT 360 (Fin 408) (Fin 112)` and its
residual conditions.  With the providers' residuals (`resIc Ic = resK ct resT 360 408`, p-disp / p-wgen) it is the
hypothesis of `bridgeHostT_gcert` / `bridgeHostTW_gcert`.
Written by p-a3 (wht45/lever, 19 Oct 2026); prepared with assistance from Claude.  No `sorry`.
-/

namespace OAI.PowerSaving.XHostT.Inst
open OAI.PowerSaving.XHostT OAI.PowerSaving.XHostT.K.DS5

/-- **the cross-replica host schedule of #3945.** -/
noncomputable def sched3945 : HostSchedT 360 (Fin 408) (Fin 112) :=
  schedOfTabOK ct rt resT 360 408 (by norm_num) whole.1 whole.2

theorem sched3945_fits : sched3945.fits (resK ct resT 360 408) :=
  schedOfTabOK_fits ct rt resT 360 408 (by norm_num) whole.1 whole.2

theorem sched3945_hrem (ρh : Fin 360) (c : Fin 9) (j : Bool × Fin 112) :
    sched3945.hrem ρh c j = K.remAt rt (2016 * ρh.val + 224 * c.val + (if j.1 then 112 else 0) + j.2.val) := rfl

end OAI.PowerSaving.XHostT.Inst

