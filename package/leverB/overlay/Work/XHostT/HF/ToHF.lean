import Work.XHostT.HF.Cert

/-!
# (key: heads-first) The BODY network of a cross-replica network and a set of head bins

Given p-a3's network `N : XNet` and a set `hb` of A4 host bins `(ρ, j)` (the heads: never hosted, remaining climb
48), with a block `blockMat (z l)` per head role `l` such that `blockMat (z l) * X0` reaches the A4 end frame `X1` for
free (`hz`; the geometry gives `X1 = shift c * blockMat z * X0`), `XNet.toHF` is the network `N'` (an `XNetH`) in which
* the head bins' A4 chain is constantly `blockMat z * X0` (the head block already applied: `hd = blockMat z`),
* their remaining climb is `0` (`hrem' = 0`), the free shift being the end step;
* everything else is `N`'s.
`XNet.unit_toHF`: `N'.unit = N.unit - |hb| * φ 48` (when `N.hrem = 48` on `hb`).
Written by p-hfirst (wht45/lever, 19 Oct 2026); the field list of `XNet.toHF` is generated by
p-hfirst/tools/mk_xneth.py from p-a3's TDef.lean; prepared with assistance from Claude.  No `sorry`.
-/

set_option linter.unusedSectionVars false
set_option linter.unusedVariables false
set_option linter.unusedSimpArgs false
set_option maxHeartbeats 4000000
namespace OAI
namespace PowerSaving
namespace XHostT
open Binary Matrix Finset RAM SS CB RF BR GF GX XHost
noncomputable section

section Role
variable {Γ T : Type} {nb nR : ℕ}

/-- the head role of host bin `(ρ, A4, j = (side, port))` in gauge `g`: the pair-4 data role of side `j.1`, class
`(g, j.2)` of replica `ρ`. -/
def hroleT (ρ : Fin nR) (g : Γ) (j : Bool × T) : BLiveT Γ T nb nR := Sum.inl (ρ, dD 4 j.1 (g, j.2))

lemma hroleT_inj {ρ ρ' : Fin nR} {g g' : Γ} {j j' : Bool × T}
    (h : (hroleT ρ g j : BLiveT Γ T nb nR) = hroleT ρ' g' j') : ρ = ρ' ∧ g = g' ∧ j = j' := by
  simp only [hroleT, Sum.inl.injEq, Prod.mk.injEq] at h
  obtain ⟨h1, h2⟩ := h
  obtain ⟨-, hs, hk⟩ := dD_inj ⟨by norm_num, le_refl 4⟩ ⟨by norm_num, le_refl 4⟩ h2
  obtain ⟨hg, ht⟩ := Prod.mk.inj hk
  exact ⟨h1, hg, Prod.ext hs ht⟩

/-- a live role of pair 1, 2 or 3 is no head role. -/
lemma hroleT_ne_pair {ρ ρ' : Fin nR} {p : ℕ} (hp : 1 ≤ p ∧ p ≤ 3) (s : Bool) (k : Γ × T) (g : Γ) (j : Bool × T) :
    (Sum.inl (ρ, dD p s k) : BLiveT Γ T nb nR) ≠ hroleT ρ' g j := by
  intro h
  simp only [hroleT, Sum.inl.injEq, Prod.mk.injEq] at h
  have h4 := (dD_inj ⟨hp.1, le_trans hp.2 (by norm_num)⟩ ⟨by norm_num, le_refl 4⟩ h.2).1
  have h3 := hp.2
  omega

/-- a bank role is no head role. -/
lemma hroleT_ne_bank (gb : Γ × Fin nb) (ρ' : Fin nR) (g : Γ) (j : Bool × T) :
    (Sum.inr gb : BLiveT Γ T nb nR) ≠ hroleT ρ' g j := by
  intro h
  simp [hroleT] at h

variable [Fintype Γ] [DecidableEq Γ] [DecidableEq T]

/-- the head roles of the bins `hb`, every gauge. -/
def headsF (hb : Finset (Fin nR × Bool × T)) : Finset (BLiveT Γ T nb nR) :=
  (hb ×ˢ (Finset.univ : Finset Γ)).image (fun p => (hroleT p.1.1 p.2 p.1.2 : BLiveT Γ T nb nR))

/-- **the head list** (duplicate free; one entry per head bin and gauge). -/
def headsL (hb : Finset (Fin nR × Bool × T)) : List (BLiveT Γ T nb nR) := (headsF hb).toList

lemma headsL_nodup (hb : Finset (Fin nR × Bool × T)) : (headsL (Γ := Γ) (nb := nb) hb).Nodup := Finset.nodup_toList _

lemma mem_headsL (hb : Finset (Fin nR × Bool × T)) (l : BLiveT Γ T nb nR) :
    l ∈ headsL hb ↔ ∃ p ∈ hb, ∃ g, hroleT p.1 g p.2 = l := by
  simp only [headsL, headsF, Finset.mem_toList, Finset.mem_image, Finset.mem_product, Finset.mem_univ, and_true]
  constructor
  · rintro ⟨⟨p, g⟩, hp, e⟩
    exact ⟨p, hp, g, e⟩
  · rintro ⟨p, hp, g, e⟩
    exact ⟨⟨p, g⟩, hp, e⟩

lemma mem_headsL_iff (hb : Finset (Fin nR × Bool × T)) (ρ : Fin nR) (g : Γ) (j : Bool × T) :
    (hroleT ρ g j : BLiveT Γ T nb nR) ∈ headsL hb ↔ (ρ, j) ∈ hb := by
  rw [mem_headsL]
  constructor
  · rintro ⟨p, hp, g', e⟩
    obtain ⟨h1, -, h3⟩ := hroleT_inj e
    rw [← h1, ← h3]
    exact hp
  · intro h
    exact ⟨(ρ, j), h, g, rfl⟩

lemma headsL_length (hb : Finset (Fin nR × Bool × T)) :
    (headsL (Γ := Γ) (nb := nb) hb).length = hb.card * Fintype.card Γ := by
  rw [headsL, Finset.length_toList, headsF, Finset.card_image_of_injective, Finset.card_product, Finset.card_univ]
  rintro ⟨⟨ρ, j⟩, g⟩ ⟨⟨ρ', j'⟩, g'⟩ e
  obtain ⟨h1, h2, h3⟩ := hroleT_inj e
  simp only at h1 h2 h3
  rw [h1, h2, h3]

end Role

section HF
variable {H T Sl C α Γ : Type} [Fintype H] [DecidableEq H] [Fintype T] [DecidableEq T]
  [Fintype Sl] [DecidableEq Sl] [Fintype C] [DecidableEq C] [Fintype α] [DecidableEq α]
  [Fintype Γ] [DecidableEq Γ]
variable {nb nR : ℕ} (N : XNet H T Sl C α Γ nb nR)

/-- the A4 start frames of `N` (those of `hH0_A4`). -/
def XNet.x0A4 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G0 g).Xm.Φ (tt (N.I.tv t))
  | (true, _) => (N.G0 g).Xm.Φ 0

/-- the A4 end frames of `N` (those of `hHE_A4`). -/
def XNet.x1A4 (g : Γ) : Bool × T → CMat α
  | (false, t) => (N.G5 (N.r5 t g)).Xm.Φ 1
  | (true, t) => (N.G5 (N.r5 t g)).Xm.Φ (1 + tt (N.I.tv t))

variable (hb : Finset (Fin nR × Bool × T)) (z : BLiveT Γ T nb nR → Fin 48 → Space α)

/-- the head pre-factor of the body network: the head block on head bins, `1` elsewhere. -/
def hdHF (ρ : Fin nR) (g : Γ) (j : Bool × T) : CMat α :=
  if (ρ, j) ∈ hb then blockMat (z (hroleT ρ g j)) else 1

/-- the host chains of the body network (head bins: constantly the head block times the start frame). -/
def XNet.hbHF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) : CMat α :=
  if c = 4 ∧ (ρh, j) ∈ hb then blockMat (z (hroleT ρh g j)) * N.x0A4 g j else N.Hb ρh c τ g j

def XNet.hpHF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) : CMat α :=
  if c = 4 ∧ (ρh, j) ∈ hb then blockMat (z (hroleT ρh g j)) * N.x0A4 g j else N.Hp ρh c τ g j

/-- the remaining climbs of the body network (head bins: `0`). -/
def XNet.hremHF (ρ : Fin nR) (c : Fin 9) (j : Bool × T) : ℕ :=
  if c = 4 ∧ (ρ, j) ∈ hb then 0 else N.hrem ρ c j

lemma XNet.hbHF_ne {c : Fin 9} (hc : c ≠ 4) (ρh : Fin nR) (τ : ℕ) (g : Γ) (j : Bool × T) :
    N.hbHF hb z ρh c τ g j = N.Hb ρh c τ g j := if_neg (fun h => hc h.1)

lemma XNet.hpHF_ne {c : Fin 9} (hc : c ≠ 4) (ρh : Fin nR) (τ : ℕ) (g : Γ) (j : Bool × T) :
    N.hpHF hb z ρh c τ g j = N.Hp ρh c τ g j := if_neg (fun h => hc h.1)

lemma XNet.hremHF_ne {c : Fin 9} (hc : c ≠ 4) (ρ : Fin nR) (j : Bool × T) :
    N.hremHF hb ρ c j = N.hrem ρ c j := if_neg (fun h => hc h.1)

lemma XNet.hHP_HF (ρh : Fin nR) (c : Fin 9) (τ : ℕ) (g : Γ) (j : Bool × T) :
    GReach (N.hbHF hb z ρh c τ g j) (N.hpHF hb z ρh c τ g j) (fun _ => 0) := by
  unfold XNet.hbHF XNet.hpHF
  split_ifs with h
  · exact GReach.refl _
  · exact N.hHP ρh c τ g j

lemma XNet.hHZn_HF (ρ : Fin nR) (l : Fin 9) (ρh : Fin nR) (c : Fin 9) (g : Γ) (j : Bool × T)
    (h : ∀ q, N.hostAt ρ l q ≠ some (ρh, c, j)) :
    N.hbHF hb z ρh c (N.tm ρ l + 1) g j = N.hpHF hb z ρh c (N.tm ρ l) g j := by
  unfold XNet.hbHF XNet.hpHF
  split_ifs with h'
  · rfl
  · exact N.hHZn ρ l ρh c g j h

lemma XNet.hH0_A4_HF (ρ : Fin nR) (g : Γ) (j : Bool × T) :
    N.hbHF hb z ρ 4 0 g j = hdHF hb z ρ g j * N.x0A4 g j := by
  unfold XNet.hbHF hdHF
  by_cases h : (ρ, j) ∈ hb
  · rw [if_pos ⟨rfl, h⟩, if_pos h]
  · rw [if_neg (fun h' => h h'.2), if_neg h, Matrix.one_mul]
    obtain ⟨s, t⟩ := j
    cases s
    · exact (N.hH0_A4 ρ g t).1
    · exact (N.hH0_A4 ρ g t).2

variable {hb z}

lemma XNet.hHE_A4_HF
    (hz : ∀ ρ j, (ρ, j) ∈ hb → ∀ g, GReach (blockMat (z (hroleT ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0))
    (ρ : Fin nR) (g : Γ) (j : Bool × T) :
    GReach (N.hbHF hb z ρ 4 (N.tm ρ 5 + 1) g j) (N.x1A4 g j) (fun φ => bcost φ (N.hremHF hb ρ 4 j)) := by
  unfold XNet.hbHF XNet.hremHF
  by_cases h : (ρ, j) ∈ hb
  · rw [if_pos ⟨rfl, h⟩, if_pos ⟨rfl, h⟩]
    exact (hz ρ j h g).cast (fun φ => (bcost_zero φ).symm)
  · rw [if_neg (fun h' => h h'.2), if_neg (fun h' => h h'.2)]
    obtain ⟨s, t⟩ := j
    cases s
    · exact (N.hHE_A4 ρ g t).1
    · exact (N.hHE_A4 ρ g t).2

