/-! ## The price of the body network -/

variable (hunh : ∀ ρ l q ρh j, (ρh, j) ∈ hb → N.hostAt ρ l q ≠ some (ρh, 4, j))
  (hz : ∀ ρ j, (ρ, j) ∈ hb → ∀ g, GReach (blockMat (z (hroleT ρ g j)) * N.x0A4 g j) (N.x1A4 g j) (fun _ => 0))

/-- the price dropped from the A4 climbs of replica `ρ`: one `φ 48` per head bin of `ρ`. -/
def hdrop (ρ : Fin nR) (φ : ℕ → ℝ) : ℝ :=
  ∑ t : T, ((if (ρ, (false, t)) ∈ hb then φ 48 else 0) + (if (ρ, (true, t)) ∈ hb then φ 48 else 0))

lemma XNet.hcost_toHF_ne (ρ : Fin nR) {c : Fin 9} (hc : c ≠ 4) (φ : ℕ → ℝ) :
    (N.toHF hb z hunh hz).hcost ρ c φ = N.hcost ρ c φ := by
  show ∑ t : T, (bcost φ (N.hremHF hb ρ c (false, t)) + bcost φ (N.hremHF hb ρ c (true, t))) = N.hcost ρ c φ
  simp only [N.hremHF_ne hb hc]
  rfl

lemma XNet.bcost_hremHF (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48) (ρ : Fin nR) (j : Bool × T) (φ : ℕ → ℝ) :
    bcost φ (N.hremHF hb ρ 4 j) = bcost φ (N.hrem ρ 4 j) - (if (ρ, j) ∈ hb then φ 48 else 0) := by
  unfold XNet.hremHF
  by_cases h : (ρ, j) ∈ hb
  · rw [if_pos ⟨rfl, h⟩, if_pos h, h48 ρ j h, bcost_zero, bcost_pos φ (by norm_num : (48 : ℕ) ≠ 0)]
    ring
  · rw [if_neg (fun h' => h h'.2), if_neg h]
    ring

lemma XNet.hcost_toHF_4 (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48) (ρ : Fin nR) (φ : ℕ → ℝ) :
    (N.toHF hb z hunh hz).hcost ρ 4 φ = N.hcost ρ 4 φ - hdrop hb ρ φ := by
  show ∑ t : T, (bcost φ (N.hremHF hb ρ 4 (false, t)) + bcost φ (N.hremHF hb ρ 4 (true, t))) = _
  simp only [N.bcost_hremHF hb h48, XNet.hcost, hdrop, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro t _
  ring

lemma XNet.tailU_toHF (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48) (ρ : Fin nR) (l : Fin 9) (φ : ℕ → ℝ) :
    (N.toHF hb z hunh hz).tailU ρ l φ = N.tailU ρ l φ - (if l = 5 then hdrop hb ρ φ else 0) := by
  fin_cases l
  · show (0 : ℝ) = 0 - (if (0 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    simp
  · show (N.toHF hb z hunh hz).hcost ρ 0 φ = N.hcost ρ 0 φ - (if (1 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide)]
  · show (N.toHF hb z hunh hz).hcost ρ 1 φ = N.hcost ρ 1 φ - (if (2 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide)]
  · show (N.toHF hb z hunh hz).hcost ρ 2 φ = N.hcost ρ 2 φ - (if (3 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide)]
  · show (N.toHF hb z hunh hz).hcost ρ 3 φ = N.hcost ρ 3 φ - (if (4 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide)]
  · show (N.toHF hb z hunh hz).hcost ρ 4 φ = N.hcost ρ 4 φ - (if (5 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_pos rfl, N.hcost_toHF_4 hb z hunh hz h48]
  · show (N.toHF hb z hunh hz).hcost ρ 5 φ = N.hcost ρ 5 φ - (if (6 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide)]
  · show (0 : ℝ) = 0 - (if (7 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    simp
  · show (N.toHF hb z hunh hz).hcost ρ 6 φ + (N.toHF hb z hunh hz).hcost ρ 7 φ + (N.toHF hb z hunh hz).hcost ρ 8 φ
        + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ)
      = N.hcost ρ 6 φ + N.hcost ρ 7 φ + N.hcost ρ 8 φ + (Fintype.card T : ℝ) * (N.cX4 φ + N.cY4 φ)
        - (if (8 : Fin 9) = 5 then hdrop hb ρ φ else 0)
    rw [if_neg (by decide), sub_zero, N.hcost_toHF_ne hb z hunh hz ρ (by decide),
      N.hcost_toHF_ne hb z hunh hz ρ (by decide), N.hcost_toHF_ne hb z hunh hz ρ (by decide)]

lemma sum_hdrop (φ : ℕ → ℝ) : ∑ ρ : Fin nR, hdrop hb ρ φ = (hb.card : ℝ) * φ 48 := by
  have e : ∑ ρ : Fin nR, hdrop hb ρ φ = ∑ p : Fin nR × Bool × T, (if p ∈ hb then φ 48 else 0) := by
    rw [Fintype.sum_prod_type]
    apply Finset.sum_congr rfl
    intro ρ _
    rw [Fintype.sum_prod_type, Fintype.sum_bool, hdrop, Finset.sum_add_distrib, add_comm]
  rw [e, Finset.sum_ite_mem, Finset.univ_inter, Finset.sum_const, nsmul_eq_mul]

/-- **the price of the body network**: the network's, less one rank-48 block per head bin. -/
theorem XNet.unit_toHF (h48 : ∀ ρ j, (ρ, j) ∈ hb → N.hrem ρ 4 j = 48) (φ : ℕ → ℝ) :
    (N.toHF hb z hunh hz).unit φ = N.unit φ - (hb.card : ℝ) * φ 48 := by
  have hc : ∀ ρ l, (N.toHF hb z hunh hz).callU ρ l φ = N.callU ρ l φ - (if l = 5 then hdrop hb ρ φ else 0) := by
    intro ρ l
    show (N.Ic ρ l).cost φ + (N.toHF hb z hunh hz).tailU ρ l φ = (N.Ic ρ l).cost φ + N.tailU ρ l φ - _
    rw [N.tailU_toHF hb z hunh hz h48]
    ring
  show (∑ ρ : Fin nR, ∑ l : Fin 9, (N.toHF hb z hunh hz).callU ρ l φ) + ∑ b, bcost φ (N.pad b)
    = (∑ ρ : Fin nR, ∑ l : Fin 9, N.callU ρ l φ) + ∑ b, bcost φ (N.pad b) - (hb.card : ℝ) * φ 48
  simp only [hc, Finset.sum_sub_distrib, Finset.sum_ite_eq', Finset.mem_univ, if_true]
  rw [sum_hdrop hb φ]
  ring

end HF
end
end XHostT
end PowerSaving
end OAI

