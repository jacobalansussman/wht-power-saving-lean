namespace OAI.PowerSaving.XHostT.Inst
open OAI.PowerSaving.XHostT OAI.PowerSaving.XHostT.K.DS5H

/-- **the cross-replica host schedule of design B (#3945, all-heads fill).** -/
noncomputable def sched3945H : HostSchedT 360 (Fin 408) (Fin 112) :=
  schedOfTabOK ct rt resT 360 408 (by norm_num) whole.1 whole.2

theorem sched3945H_fits : sched3945H.fits (resK ct resT 360 408) :=
  schedOfTabOK_fits ct rt resT 360 408 (by norm_num) whole.1 whole.2

theorem sched3945H_hrem (ρh : Fin 360) (c : Fin 9) (j : Bool × Fin 112) :
    sched3945H.hrem ρh c j = K.remAt rt (2016 * ρh.val + 224 * c.val + (if j.1 then 112 else 0) + j.2.val) := rfl

end OAI.PowerSaving.XHostT.Inst

#print axioms OAI.PowerSaving.XHostT.Inst.sched3945H_fits
