def decimalExponentL3945H : ℝ := 1 - 17581520/(10^(10:ℕ))

def decimalTimeL3945H (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentL3945H

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsL3945H (W : ℕ → ℕ) : Prop :=
