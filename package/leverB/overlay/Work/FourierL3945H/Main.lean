/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderL3945H : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsL3945H W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneL3945H
  exact ⟨o,s,lunchL3945H a b id,hp,Skies.time_boundL3945H (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderL3945H : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsL3945H W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothL3945H
  have h (n : ℕ) : n ≤ stretchL3945H n ∧ stretchL3945H n ≤ 2*n := by unfold stretchL3945H; omega
  exact ⟨o,s,lunchL3945H a b stretchL3945H,hp,Skies.time_boundL3945H h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posL3945H hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 17581520/10^10))`.**
