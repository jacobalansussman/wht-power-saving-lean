theorem transform_mainL3945H : DFTGoalL3945H :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderL3945H
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainL3945H : ConvGoalL3945H :=
