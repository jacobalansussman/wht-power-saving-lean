lemma multiplier_rangeL3945H : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltL3945H : theta < 1 := by
  have h := multiplier_rangeL3945H
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaL3945H : alphaL3945H < theta := by
  let d : ℝ := 1758152001/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeL3945H.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minL3945H
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeL3945H : alphaL3945H < decimalExponentL3945H ∧ decimalExponentL3945H < 1 := by
  norm_num [decimalExponentL3945H,alphaL3945H]

def speedL3945H (v : ℝ) (n : ℕ) := (n:ℝ)*(TmL3945H n)^v

lemma flight_littleL3945H {v : ℝ} (h : alphaL3945H < v) :
    flightL3945H =o[atTop] speedL3945H v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945H.eventually_ge_atTop 1,dwarfL3945H TtopL3945H 2
    (p:=v-alphaL3945H) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945H n := by linarith
  change ‖(n:ℝ)*TmL3945H n^alphaL3945H*QmL3945H n^2‖ ≤ c*‖(n:ℝ)*TmL3945H n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmL3945H n^alphaL3945H)*(c*TmL3945H n^(v-alphaL3945H)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmL3945H n^alphaL3945H*TmL3945H n^(v-alphaL3945H))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaL3945H + (v-alphaL3945H)=v by ring] -- a+(v-a)

lemma speed_littleL3945H {u v : ℝ} (h : u < v) :
    speedL3945H u =o[atTop] speedL3945H v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945H.eventually_ge_atTop 1,dwarfL3945H TtopL3945H 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945H n := by linarith
  change ‖(n:ℝ)*TmL3945H n^u‖ ≤ c*‖(n:ℝ)*TmL3945H n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmL3945H n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmL3945H n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmL3945H n^u)*(c*TmL3945H n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmL3945H n^u*TmL3945H n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleL3945H : decimalTimeL3945H =o[atTop] nlogn := by
  have H := speed_littleL3945H decimal_rangeL3945H.2
  have h : speedL3945H 1 = nlogn := funext fun n => by rw [speedL3945H,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperL3945H : speedL3945H theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopL3945H.eventually_ge_atTop 1,QtopL3945H.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmL3945H n := by linarith
  have he' : 0<QmL3945H n := by linarith
  change ‖(n:ℝ)*TmL3945H n^theta‖ ≤ 1*‖(n:ℝ)*TmL3945H n^theta*QmL3945H n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltL3945H])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundL3945H {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationL3945H) :
    TimeBoundsL3945H (lunchL3945H a b N) := by
  have H := lunch_bigL3945H a b h
  have hp := H.trans_isLittleO (flight_littleL3945H alpha_thetaL3945H)
  have hd := H.trans_isLittleO (flight_littleL3945H decimal_rangeL3945H.1)
  have ht : (fun n => (lunchL3945H a b N n:ℝ)) =O[atTop] decimalTimeL3945H := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperL3945H,ht,ht.trans_isLittleO decimal_littleL3945H⟩

