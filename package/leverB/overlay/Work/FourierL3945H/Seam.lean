/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL3945H : ℝ := 1 - 1758152001/(10:ℝ)^12

theorem alphaL3945H_pos : 0 < alphaL3945H := by norm_num [alphaL3945H]
theorem alphaL3945H_lt : alphaL3945H < 1 := by norm_num [alphaL3945H]

lemma envelope_monoL3945H (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL3945H {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL3945H (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL3945H)

lemma hillsL3945H_eq_envelope : hillsL3945H = envelope alphaL3945H := rfl

lemma hillsL3945H_pos (k : ℕ) : 1≤hillsL3945H k := envelope_pos alphaL3945H k

lemma hillsL3945H_mono {a b : ℕ} (h : a≤b) : hillsL3945H a ≤ hillsL3945H b := envelope_monoL3945H alphaL3945H alphaL3945H_pos.le h

lemma hillsL3945H_le (k : ℕ) : hillsL3945H k ≤ k+1 := envelope_le alphaL3945H alphaL3945H_lt.le k

lemma hillsL3945H_real (k : ℕ) : (hillsL3945H k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL3945H := envelope_real alphaL3945H alphaL3945H_pos.le k

/-! ## 3. The kernel program at `alphaL3945H` -/

namespace SeamL3945H
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL3945H = 1 - 1758152001/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L3945H (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL3945H (k i)) :=
  MX.L3945H.EngineStmt.lift MX.L3945H.engine cl m k v

end SeamL3945H

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL3945H`
(exponent `1 - 1758152001/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL3945H.engine_L3945H`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL3945H k` operations. -/
theorem hillsL3945H_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL3945H (k i)) :=
  SeamL3945H.engine_L3945H cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL3945H`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL3945H (z : ℝ) (hz : alphaL3945H ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL3945H_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL3945H hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

namespace SeamL3945H

lemma alphaL3945H_lt_alpha : alphaL3945H < alpha := by norm_num [alphaL3945H, alpha]

/-- for `Skies.alpha_theta` (Main.lean:39): below the paper's exponent. -/
lemma alphaL3945H_theta : alphaL3945H < theta := alphaL3945H_lt_alpha.trans Skies.alpha_theta

/-- for `Skies.decimal_range` (Main.lean:59). -/
lemma alphaL3945H_decimal : alphaL3945H < decimalExponent ∧ decimalExponent < 1 := by
  norm_num [decimalExponent, alphaL3945H]

/-- Target exponent of the final Fourier statement: strictly above `alphaL3945H`, so that the
`(log log n)^2` factor of the reduction is absorbed. -/
def targetExponentL3945H : ℝ := 1 - 17581520/(10:ℝ)^10
/-- Fallback exponent. -/
def fallbackExponentL3945H : ℝ := 1 - 102210/(10:ℝ)^8

lemma alphaL3945H_lt_target : alphaL3945H < targetExponentL3945H := by norm_num [alphaL3945H, targetExponentL3945H]
lemma alphaL3945H_lt_fallback : alphaL3945H < fallbackExponentL3945H := by norm_num [alphaL3945H, fallbackExponentL3945H]
lemma target_lt_fallbackL3945H : targetExponentL3945H < fallbackExponentL3945H := by
  norm_num [targetExponentL3945H, fallbackExponentL3945H]
lemma target_posL3945H : 0 < targetExponentL3945H := by norm_num [targetExponentL3945H]
lemma target_lt_oneL3945H : targetExponentL3945H < 1 := by norm_num [targetExponentL3945H]
lemma fallback_lt_oneL3945H : fallbackExponentL3945H < 1 := by norm_num [fallbackExponentL3945H]
lemma target_lt_decimalL3945H : targetExponentL3945H < decimalExponent := by
  norm_num [targetExponentL3945H, decimalExponent]
lemma fallback_lt_decimalL3945H : fallbackExponentL3945H < decimalExponent := by
  norm_num [fallbackExponentL3945H, decimalExponent]
lemma target_lt_thetaL3945H : targetExponentL3945H < theta :=
  (show targetExponentL3945H < alpha by norm_num [targetExponentL3945H, alpha]).trans Skies.alpha_theta
lemma fallback_lt_thetaL3945H : fallbackExponentL3945H < theta :=
  (show fallbackExponentL3945H < alpha by norm_num [fallbackExponentL3945H, alpha]).trans Skies.alpha_theta

end SeamL3945H
