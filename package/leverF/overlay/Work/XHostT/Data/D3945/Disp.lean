import Work.XHostD.Prov

/-! #3945's dispatch table (Dugongue's owner layer, `owner/inputs/DISPATCH.json` sha256 5d6fa711d704a1b498e5fe066ea821c4fa0217463702e82a7ce5be9da4023e8a and `ORDER.json`
sha256 743e74b538432e2b2045e754b0de9c18f36fc5039fdb8eb542177a898ec78e44 on the PR branch, read-only copies): 3240 calls (360 replicas x 9 stages), provider 0 = `extra` (1672 calls),
provider 1 = `gauge44` (1568 calls).  `dispKB`: bit `k` = provider of call `k = 9 ρ + l`; `dispGB`: bit `τ` = provider of
the call at global time `τ` (bit tables: the kernel reads a bit in one step).  Generated by p-disp/tools/mk_disp3945.py (wht45/lever, 19 Oct 2026), which
checks the order (every call once, stages increasing in time per replica), the tags and the counts, and refuses a count
one off; prepared with assistance from Claude.  No `sorry`. -/

set_option maxRecDepth 100000
namespace OAI.PowerSaving.XHostT.D3945
open OAI.PowerSaving.XHostD Finset

/-- the table by call: bit `k` is the provider of call `k = 9 ρ + l` (0 = extra, 1 = gauge44). -/
def dispKB : Nat := 
/-- the table by global call: bit `τ` is the provider of the call at global time `τ` (ORDER.json). -/
def dispGB : Nat := 

/-- the provider (0 or 1) at bit `k` of a table. -/
def bitP (B k : Nat) : Fin 2 := if (B >>> k) &&& 1 = 1 then 1 else 0

/-- **the dispatch of the network**: call `(ρ, l)` runs provider `bitP dispKB (9 ρ + l)`. -/
def disp : Fin 360 × Fin 9 → Fin 2 := fun c => bitP dispKB (9 * c.1.val + c.2.val)

/-- **the counts of the real table** (the hub's 1672 extra and 1568 gauge44 calls). -/
theorem nExtra : nCalls disp 0 = 1672 := by decide +kernel
theorem nGauge : nCalls disp 1 = 1568 := by decide +kernel

/-- negative control: one call more is false (the count is computed, not assumed). -/
theorem nExtra_ne_succ : nCalls disp 0 ≠ 1672 + 1 := by decide +kernel
theorem nGauge_ne_succ : nCalls disp 1 ≠ 1568 + 1 := by decide +kernel

/-- the table by global call (the hub's order). -/
def dispG : Fin (9 * 360) → Fin 2 := fun τ => bitP dispGB τ.val
theorem nExtraG : nCalls dispG 0 = 1672 := by decide +kernel
theorem nGaugeG : nCalls dispG 1 = 1568 := by decide +kernel

/-- the first 8 replicas of the table (calls `k < 72`), for the 8-replica controls: 69 extra, 3 gauge44. -/
def disp8 : Fin 8 × Fin 9 → Fin 2 := fun c => bitP dispKB (9 * c.1.val + c.2.val)
theorem n8Extra : nCalls disp8 0 = 69 := by decide +kernel
theorem n8Gauge : nCalls disp8 1 = 3 := by decide +kernel

end OAI.PowerSaving.XHostT.D3945
