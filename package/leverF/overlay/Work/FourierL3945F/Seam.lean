/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL3945F : ℝ := 1 - 1780693501/(10:ℝ)^12

theorem alphaL3945F_pos : 0 < alphaL3945F := by norm_num [alphaL3945F]
theorem alphaL3945F_lt : alphaL3945F < 1 := by norm_num [alphaL3945F]

lemma envelope_monoL3945F (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL3945F {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL3945F (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL3945F)

lemma hillsL3945F_eq_envelope : hillsL3945F = envelope alphaL3945F := rfl

lemma hillsL3945F_pos (k : ℕ) : 1≤hillsL3945F k := envelope_pos alphaL3945F k

lemma hillsL3945F_mono {a b : ℕ} (h : a≤b) : hillsL3945F a ≤ hillsL3945F b := envelope_monoL3945F alphaL3945F alphaL3945F_pos.le h

lemma hillsL3945F_le (k : ℕ) : hillsL3945F k ≤ k+1 := envelope_le alphaL3945F alphaL3945F_lt.le k

lemma hillsL3945F_real (k : ℕ) : (hillsL3945F k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL3945F := envelope_real alphaL3945F alphaL3945F_pos.le k

/-! ## 3. The kernel program at `alphaL3945F` -/

namespace SeamL3945F
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL3945F = 1 - 1780693501/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L3945F (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL3945F (k i)) :=
  MX.L3945F.EngineStmt.lift MX.L3945F.engine cl m k v

end SeamL3945F

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL3945F`
(exponent `1 - 1780693501/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL3945F.engine_L3945F`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL3945F k` operations. -/
theorem hillsL3945F_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL3945F (k i)) :=
  SeamL3945F.engine_L3945F cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL3945F`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL3945F (z : ℝ) (hz : alphaL3945F ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL3945F_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL3945F hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

namespace SeamL3945F

lemma alphaL3945F_lt_alpha : alphaL3945F < alpha := by norm_num [alphaL3945F, alpha]

/-- for `Skies.alpha_theta` (Main.lean:39): below the paper's exponent. -/
lemma alphaL3945F_theta : alphaL3945F < theta := alphaL3945F_lt_alpha.trans Skies.alpha_theta

/-- for `Skies.decimal_range` (Main.lean:59). -/
lemma alphaL3945F_decimal : alphaL3945F < decimalExponent ∧ decimalExponent < 1 := by
  norm_num [decimalExponent, alphaL3945F]

/-- Target exponent of the final Fourier statement: strictly above `alphaL3945F`, so that the
`(log log n)^2` factor of the reduction is absorbed. -/
def targetExponentL3945F : ℝ := 1 - 17806935/(10:ℝ)^10
/-- Fallback exponent. -/
def fallbackExponentL3945F : ℝ := 1 - 102210/(10:ℝ)^8

lemma alphaL3945F_lt_target : alphaL3945F < targetExponentL3945F := by norm_num [alphaL3945F, targetExponentL3945F]
lemma alphaL3945F_lt_fallback : alphaL3945F < fallbackExponentL3945F := by norm_num [alphaL3945F, fallbackExponentL3945F]
lemma target_lt_fallbackL3945F : targetExponentL3945F < fallbackExponentL3945F := by
  norm_num [targetExponentL3945F, fallbackExponentL3945F]
lemma target_posL3945F : 0 < targetExponentL3945F := by norm_num [targetExponentL3945F]
lemma target_lt_oneL3945F : targetExponentL3945F < 1 := by norm_num [targetExponentL3945F]
lemma fallback_lt_oneL3945F : fallbackExponentL3945F < 1 := by norm_num [fallbackExponentL3945F]
lemma target_lt_decimalL3945F : targetExponentL3945F < decimalExponent := by
  norm_num [targetExponentL3945F, decimalExponent]
lemma fallback_lt_decimalL3945F : fallbackExponentL3945F < decimalExponent := by
  norm_num [fallbackExponentL3945F, decimalExponent]
lemma target_lt_thetaL3945F : targetExponentL3945F < theta :=
  (show targetExponentL3945F < alpha by norm_num [targetExponentL3945F, alpha]).trans Skies.alpha_theta
lemma fallback_lt_thetaL3945F : fallbackExponentL3945F < theta :=
  (show fallbackExponentL3945F < alpha by norm_num [fallbackExponentL3945F, alpha]).trans Skies.alpha_theta

end SeamL3945F
