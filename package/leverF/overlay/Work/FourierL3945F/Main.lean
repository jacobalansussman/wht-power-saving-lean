/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderL3945F : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsL3945F W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneL3945F
  exact ⟨o,s,lunchL3945F a b id,hp,Skies.time_boundL3945F (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderL3945F : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsL3945F W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothL3945F
  have h (n : ℕ) : n ≤ stretchL3945F n ∧ stretchL3945F n ≤ 2*n := by unfold stretchL3945F; omega
  exact ⟨o,s,lunchL3945F a b stretchL3945F,hp,Skies.time_boundL3945F h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posL3945F hn)).2⟩⟩

