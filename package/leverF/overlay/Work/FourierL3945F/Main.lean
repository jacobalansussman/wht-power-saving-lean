lemma multiplier_rangeL3945F : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltL3945F : theta < 1 := by
  have h := multiplier_rangeL3945F
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaL3945F : alphaL3945F < theta := by
  let d : ℝ := 1780693501/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeL3945F.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minL3945F
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeL3945F : alphaL3945F < decimalExponentL3945F ∧ decimalExponentL3945F < 1 := by
  norm_num [decimalExponentL3945F,alphaL3945F]

def speedL3945F (v : ℝ) (n : ℕ) := (n:ℝ)*(TmL3945F n)^v

lemma flight_littleL3945F {v : ℝ} (h : alphaL3945F < v) :
    flightL3945F =o[atTop] speedL3945F v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945F.eventually_ge_atTop 1,dwarfL3945F TtopL3945F 2
    (p:=v-alphaL3945F) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945F n := by linarith
  change ‖(n:ℝ)*TmL3945F n^alphaL3945F*QmL3945F n^2‖ ≤ c*‖(n:ℝ)*TmL3945F n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmL3945F n^alphaL3945F)*(c*TmL3945F n^(v-alphaL3945F)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmL3945F n^alphaL3945F*TmL3945F n^(v-alphaL3945F))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaL3945F + (v-alphaL3945F)=v by ring] -- a+(v-a)

lemma speed_littleL3945F {u v : ℝ} (h : u < v) :
    speedL3945F u =o[atTop] speedL3945F v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945F.eventually_ge_atTop 1,dwarfL3945F TtopL3945F 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945F n := by linarith
  change ‖(n:ℝ)*TmL3945F n^u‖ ≤ c*‖(n:ℝ)*TmL3945F n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmL3945F n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmL3945F n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmL3945F n^u)*(c*TmL3945F n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmL3945F n^u*TmL3945F n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleL3945F : decimalTimeL3945F =o[atTop] nlogn := by
  have H := speed_littleL3945F decimal_rangeL3945F.2
  have h : speedL3945F 1 = nlogn := funext fun n => by rw [speedL3945F,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperL3945F : speedL3945F theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopL3945F.eventually_ge_atTop 1,QtopL3945F.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmL3945F n := by linarith
  have he' : 0<QmL3945F n := by linarith
  change ‖(n:ℝ)*TmL3945F n^theta‖ ≤ 1*‖(n:ℝ)*TmL3945F n^theta*QmL3945F n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltL3945F])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundL3945F {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationL3945F) :
    TimeBoundsL3945F (lunchL3945F a b N) := by
  have H := lunch_bigL3945F a b h
  have hp := H.trans_isLittleO (flight_littleL3945F alpha_thetaL3945F)
  have hd := H.trans_isLittleO (flight_littleL3945F decimal_rangeL3945F.1)
  have ht : (fun n => (lunchL3945F a b N n:ℝ)) =O[atTop] decimalTimeL3945F := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperL3945F,ht,ht.trans_isLittleO decimal_littleL3945F⟩

