/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderU8X0HQ : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsU8X0HQ W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneU8X0HQ
  exact ⟨o,s,lunchU8X0HQ a b id,hp,Skies.time_boundU8X0HQ (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderU8X0HQ : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsU8X0HQ W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothU8X0HQ
  have h (n : ℕ) : n ≤ stretchU8X0HQ n ∧ stretchU8X0HQ n ≤ 2*n := by unfold stretchU8X0HQ; omega
  exact ⟨o,s,lunchU8X0HQ a b stretchU8X0HQ,hp,Skies.time_boundU8X0HQ h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posU8X0HQ hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 16256629/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentU8X0HQ = 1 - 16256629/10^10`
(Work/FourierU8X0HQ/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_U8X0HQx`: both
follow from one kernel program, `RAM.hillsU8X0HQ_program` (Work/FourierU8X0HQ/Seam.lean). -/
theorem transform_mainU8X0HQ : DFTGoalU8X0HQ :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderU8X0HQ
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainU8X0HQ : ConvGoalU8X0HQ :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderU8X0HQ
  ⟨o,s,W,h,g⟩

