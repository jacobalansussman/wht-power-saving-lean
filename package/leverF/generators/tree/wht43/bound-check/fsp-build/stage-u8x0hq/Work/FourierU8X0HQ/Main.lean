lemma multiplier_rangeU8X0HQ : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltU8X0HQ : theta < 1 := by
  have h := multiplier_rangeU8X0HQ
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaU8X0HQ : alphaU8X0HQ < theta := by
  let d : ℝ := 16256630/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeU8X0HQ.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minU8X0HQ
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeU8X0HQ : alphaU8X0HQ < decimalExponentU8X0HQ ∧ decimalExponentU8X0HQ < 1 := by
  norm_num [decimalExponentU8X0HQ,alphaU8X0HQ]

def speedU8X0HQ (v : ℝ) (n : ℕ) := (n:ℝ)*(TmU8X0HQ n)^v

lemma flight_littleU8X0HQ {v : ℝ} (h : alphaU8X0HQ < v) :
    flightU8X0HQ =o[atTop] speedU8X0HQ v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8X0HQ.eventually_ge_atTop 1,dwarfU8X0HQ TtopU8X0HQ 2
    (p:=v-alphaU8X0HQ) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8X0HQ n := by linarith
  change ‖(n:ℝ)*TmU8X0HQ n^alphaU8X0HQ*QmU8X0HQ n^2‖ ≤ c*‖(n:ℝ)*TmU8X0HQ n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmU8X0HQ n^alphaU8X0HQ)*(c*TmU8X0HQ n^(v-alphaU8X0HQ)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmU8X0HQ n^alphaU8X0HQ*TmU8X0HQ n^(v-alphaU8X0HQ))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaU8X0HQ + (v-alphaU8X0HQ)=v by ring] -- a+(v-a)

lemma speed_littleU8X0HQ {u v : ℝ} (h : u < v) :
    speedU8X0HQ u =o[atTop] speedU8X0HQ v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8X0HQ.eventually_ge_atTop 1,dwarfU8X0HQ TtopU8X0HQ 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8X0HQ n := by linarith
  change ‖(n:ℝ)*TmU8X0HQ n^u‖ ≤ c*‖(n:ℝ)*TmU8X0HQ n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmU8X0HQ n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmU8X0HQ n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmU8X0HQ n^u)*(c*TmU8X0HQ n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmU8X0HQ n^u*TmU8X0HQ n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleU8X0HQ : decimalTimeU8X0HQ =o[atTop] nlogn := by
  have H := speed_littleU8X0HQ decimal_rangeU8X0HQ.2
  have h : speedU8X0HQ 1 = nlogn := funext fun n => by rw [speedU8X0HQ,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperU8X0HQ : speedU8X0HQ theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopU8X0HQ.eventually_ge_atTop 1,QtopU8X0HQ.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmU8X0HQ n := by linarith
  have he' : 0<QmU8X0HQ n := by linarith
  change ‖(n:ℝ)*TmU8X0HQ n^theta‖ ≤ 1*‖(n:ℝ)*TmU8X0HQ n^theta*QmU8X0HQ n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltU8X0HQ])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundU8X0HQ {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationU8X0HQ) :
    TimeBoundsU8X0HQ (lunchU8X0HQ a b N) := by
  have H := lunch_bigU8X0HQ a b h
  have hp := H.trans_isLittleO (flight_littleU8X0HQ alpha_thetaU8X0HQ)
  have hd := H.trans_isLittleO (flight_littleU8X0HQ decimal_rangeU8X0HQ.1)
  have ht : (fun n => (lunchU8X0HQ a b N n:ℝ)) =O[atTop] decimalTimeU8X0HQ := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperU8X0HQ,ht,ht.trans_isLittleO decimal_littleU8X0HQ⟩

