/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL2979H : ℝ := 1 - 1756470701/(10:ℝ)^12

theorem alphaL2979H_pos : 0 < alphaL2979H := by norm_num [alphaL2979H]
theorem alphaL2979H_lt : alphaL2979H < 1 := by norm_num [alphaL2979H]

lemma envelope_monoL2979H (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL2979H {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL2979H (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL2979H)

lemma hillsL2979H_eq_envelope : hillsL2979H = envelope alphaL2979H := rfl

lemma hillsL2979H_pos (k : ℕ) : 1≤hillsL2979H k := envelope_pos alphaL2979H k

lemma hillsL2979H_mono {a b : ℕ} (h : a≤b) : hillsL2979H a ≤ hillsL2979H b := envelope_monoL2979H alphaL2979H alphaL2979H_pos.le h

lemma hillsL2979H_le (k : ℕ) : hillsL2979H k ≤ k+1 := envelope_le alphaL2979H alphaL2979H_lt.le k

lemma hillsL2979H_real (k : ℕ) : (hillsL2979H k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL2979H := envelope_real alphaL2979H alphaL2979H_pos.le k

/-! ## 3. The kernel program at `alphaL2979H` -/

namespace SeamL2979H
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL2979H = 1 - 1756470701/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L2979H (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL2979H (k i)) :=
  MX.L2979H.EngineStmt.lift MX.L2979H.engine cl m k v

end SeamL2979H

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL2979H`
(exponent `1 - 1756470701/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL2979H.engine_L2979H`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL2979H k` operations. -/
theorem hillsL2979H_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL2979H (k i)) :=
  SeamL2979H.engine_L2979H cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL2979H`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL2979H (z : ℝ) (hz : alphaL2979H ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL2979H_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL2979H hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

namespace SeamL2979H

lemma alphaL2979H_lt_alpha : alphaL2979H < alpha := by norm_num [alphaL2979H, alpha]

/-- for `Skies.alpha_theta` (Main.lean:39): below the paper's exponent. -/
lemma alphaL2979H_theta : alphaL2979H < theta := alphaL2979H_lt_alpha.trans Skies.alpha_theta

/-- for `Skies.decimal_range` (Main.lean:59). -/
lemma alphaL2979H_decimal : alphaL2979H < decimalExponent ∧ decimalExponent < 1 := by
  norm_num [decimalExponent, alphaL2979H]

/-- Target exponent of the final Fourier statement: strictly above `alphaL2979H`, so that the
`(log log n)^2` factor of the reduction is absorbed. -/
def targetExponentL2979H : ℝ := 1 - 17564707/(10:ℝ)^10
/-- Fallback exponent. -/
def fallbackExponentL2979H : ℝ := 1 - 102210/(10:ℝ)^8

lemma alphaL2979H_lt_target : alphaL2979H < targetExponentL2979H := by norm_num [alphaL2979H, targetExponentL2979H]
lemma alphaL2979H_lt_fallback : alphaL2979H < fallbackExponentL2979H := by norm_num [alphaL2979H, fallbackExponentL2979H]
lemma target_lt_fallbackL2979H : targetExponentL2979H < fallbackExponentL2979H := by
  norm_num [targetExponentL2979H, fallbackExponentL2979H]
lemma target_posL2979H : 0 < targetExponentL2979H := by norm_num [targetExponentL2979H]
lemma target_lt_oneL2979H : targetExponentL2979H < 1 := by norm_num [targetExponentL2979H]
lemma fallback_lt_oneL2979H : fallbackExponentL2979H < 1 := by norm_num [fallbackExponentL2979H]
lemma target_lt_decimalL2979H : targetExponentL2979H < decimalExponent := by
  norm_num [targetExponentL2979H, decimalExponent]
lemma fallback_lt_decimalL2979H : fallbackExponentL2979H < decimalExponent := by
  norm_num [fallbackExponentL2979H, decimalExponent]
lemma target_lt_thetaL2979H : targetExponentL2979H < theta :=
  (show targetExponentL2979H < alpha by norm_num [targetExponentL2979H, alpha]).trans Skies.alpha_theta
lemma fallback_lt_thetaL2979H : fallbackExponentL2979H < theta :=
  (show fallbackExponentL2979H < alpha by norm_num [fallbackExponentL2979H, alpha]).trans Skies.alpha_theta

end SeamL2979H
