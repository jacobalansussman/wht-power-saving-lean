/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL2979 : ℝ := 1 - 1755647301/(10:ℝ)^12

theorem alphaL2979_pos : 0 < alphaL2979 := by norm_num [alphaL2979]
theorem alphaL2979_lt : alphaL2979 < 1 := by norm_num [alphaL2979]

lemma envelope_monoL2979 (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL2979 {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL2979 (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL2979)

lemma hillsL2979_eq_envelope : hillsL2979 = envelope alphaL2979 := rfl

lemma hillsL2979_pos (k : ℕ) : 1≤hillsL2979 k := envelope_pos alphaL2979 k

lemma hillsL2979_mono {a b : ℕ} (h : a≤b) : hillsL2979 a ≤ hillsL2979 b := envelope_monoL2979 alphaL2979 alphaL2979_pos.le h

lemma hillsL2979_le (k : ℕ) : hillsL2979 k ≤ k+1 := envelope_le alphaL2979 alphaL2979_lt.le k

lemma hillsL2979_real (k : ℕ) : (hillsL2979 k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL2979 := envelope_real alphaL2979 alphaL2979_pos.le k

/-! ## 3. The kernel program at `alphaL2979` -/

namespace SeamL2979
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL2979 = 1 - 1755647301/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L2979 (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL2979 (k i)) :=
  MX.L2979.EngineStmt.lift MX.L2979.engine cl m k v

end SeamL2979

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL2979`
(exponent `1 - 1755647301/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL2979.engine_L2979`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL2979 k` operations. -/
theorem hillsL2979_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL2979 (k i)) :=
  SeamL2979.engine_L2979 cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL2979`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL2979 (z : ℝ) (hz : alphaL2979 ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL2979_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL2979 hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

namespace SeamL2979

lemma alphaL2979_lt_alpha : alphaL2979 < alpha := by norm_num [alphaL2979, alpha]

/-- for `Skies.alpha_theta` (Main.lean:39): below the paper's exponent. -/
lemma alphaL2979_theta : alphaL2979 < theta := alphaL2979_lt_alpha.trans Skies.alpha_theta

/-- for `Skies.decimal_range` (Main.lean:59). -/
lemma alphaL2979_decimal : alphaL2979 < decimalExponent ∧ decimalExponent < 1 := by
  norm_num [decimalExponent, alphaL2979]

/-- Target exponent of the final Fourier statement: strictly above `alphaL2979`, so that the
`(log log n)^2` factor of the reduction is absorbed. -/
def targetExponentL2979 : ℝ := 1 - 17556473/(10:ℝ)^10
/-- Fallback exponent. -/
def fallbackExponentL2979 : ℝ := 1 - 102210/(10:ℝ)^8

lemma alphaL2979_lt_target : alphaL2979 < targetExponentL2979 := by norm_num [alphaL2979, targetExponentL2979]
lemma alphaL2979_lt_fallback : alphaL2979 < fallbackExponentL2979 := by norm_num [alphaL2979, fallbackExponentL2979]
lemma target_lt_fallbackL2979 : targetExponentL2979 < fallbackExponentL2979 := by
  norm_num [targetExponentL2979, fallbackExponentL2979]
lemma target_posL2979 : 0 < targetExponentL2979 := by norm_num [targetExponentL2979]
lemma target_lt_oneL2979 : targetExponentL2979 < 1 := by norm_num [targetExponentL2979]
lemma fallback_lt_oneL2979 : fallbackExponentL2979 < 1 := by norm_num [fallbackExponentL2979]
lemma target_lt_decimalL2979 : targetExponentL2979 < decimalExponent := by
  norm_num [targetExponentL2979, decimalExponent]
lemma fallback_lt_decimalL2979 : fallbackExponentL2979 < decimalExponent := by
  norm_num [fallbackExponentL2979, decimalExponent]
lemma target_lt_thetaL2979 : targetExponentL2979 < theta :=
  (show targetExponentL2979 < alpha by norm_num [targetExponentL2979, alpha]).trans Skies.alpha_theta
lemma fallback_lt_thetaL2979 : fallbackExponentL2979 < theta :=
  (show fallbackExponentL2979 < alpha by norm_num [fallbackExponentL2979, alpha]).trans Skies.alpha_theta

end SeamL2979
