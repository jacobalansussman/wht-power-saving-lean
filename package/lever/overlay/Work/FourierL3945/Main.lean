lemma multiplier_rangeL3945 : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltL3945 : theta < 1 := by
  have h := multiplier_rangeL3945
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaL3945 : alphaL3945 < theta := by
  let d : ℝ := 1750110901/(10:ℝ)^12
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeL3945.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minL3945
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeL3945 : alphaL3945 < decimalExponentL3945 ∧ decimalExponentL3945 < 1 := by
  norm_num [decimalExponentL3945,alphaL3945]

def speedL3945 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmL3945 n)^v

lemma flight_littleL3945 {v : ℝ} (h : alphaL3945 < v) :
    flightL3945 =o[atTop] speedL3945 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945.eventually_ge_atTop 1,dwarfL3945 TtopL3945 2
    (p:=v-alphaL3945) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945 n := by linarith
  change ‖(n:ℝ)*TmL3945 n^alphaL3945*QmL3945 n^2‖ ≤ c*‖(n:ℝ)*TmL3945 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmL3945 n^alphaL3945)*(c*TmL3945 n^(v-alphaL3945)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmL3945 n^alphaL3945*TmL3945 n^(v-alphaL3945))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaL3945 + (v-alphaL3945)=v by ring] -- a+(v-a)

lemma speed_littleL3945 {u v : ℝ} (h : u < v) :
    speedL3945 u =o[atTop] speedL3945 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopL3945.eventually_ge_atTop 1,dwarfL3945 TtopL3945 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmL3945 n := by linarith
  change ‖(n:ℝ)*TmL3945 n^u‖ ≤ c*‖(n:ℝ)*TmL3945 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmL3945 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmL3945 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmL3945 n^u)*(c*TmL3945 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmL3945 n^u*TmL3945 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleL3945 : decimalTimeL3945 =o[atTop] nlogn := by
  have H := speed_littleL3945 decimal_rangeL3945.2
  have h : speedL3945 1 = nlogn := funext fun n => by rw [speedL3945,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperL3945 : speedL3945 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopL3945.eventually_ge_atTop 1,QtopL3945.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmL3945 n := by linarith
  have he' : 0<QmL3945 n := by linarith
  change ‖(n:ℝ)*TmL3945 n^theta‖ ≤ 1*‖(n:ℝ)*TmL3945 n^theta*QmL3945 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltL3945])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundL3945 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationL3945) :
    TimeBoundsL3945 (lunchL3945 a b N) := by
  have H := lunch_bigL3945 a b h
  have hp := H.trans_isLittleO (flight_littleL3945 alpha_thetaL3945)
  have hd := H.trans_isLittleO (flight_littleL3945 decimal_rangeL3945.1)
  have ht : (fun n => (lunchL3945 a b N n:ℝ)) =O[atTop] decimalTimeL3945 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperL3945,ht,ht.trans_isLittleO decimal_littleL3945⟩

