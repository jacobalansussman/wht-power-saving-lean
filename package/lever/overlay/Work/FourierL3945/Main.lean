/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderL3945 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsL3945 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneL3945
  exact ⟨o,s,lunchL3945 a b id,hp,Skies.time_boundL3945 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderL3945 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsL3945 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothL3945
  have h (n : ℕ) : n ≤ stretchL3945 n ∧ stretchL3945 n ≤ 2*n := by unfold stretchL3945; omega
  exact ⟨o,s,lunchL3945 a b stretchL3945,hp,Skies.time_boundL3945 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posL3945 hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 17501109/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentL3945 = 1 - 17501109/10^10`
(Work/FourierL3945/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_L3945x`: both
follow from one kernel program, `RAM.hillsL3945_program` (Work/FourierL3945/Seam.lean). -/
theorem transform_mainL3945 : DFTGoalL3945 :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderL3945
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainL3945 : ConvGoalL3945 :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderL3945
  ⟨o,s,W,h,g⟩

