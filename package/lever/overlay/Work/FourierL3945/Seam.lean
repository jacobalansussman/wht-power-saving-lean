/-! ## 1. The exponent and the envelope facts -/

/-- Our exponent, in the place of OpenAI's `alpha` (TensorSaving.lean:81). -/
def alphaL3945 : ℝ := 1 - 1750110901/(10:ℝ)^12

theorem alphaL3945_pos : 0 < alphaL3945 := by norm_num [alphaL3945]
theorem alphaL3945_lt : alphaL3945 < 1 := by norm_num [alphaL3945]

lemma envelope_monoL3945 (z : ℝ) (hz : 0 ≤ z) {a b : ℕ} (h : a ≤ b) : envelope z a ≤ envelope z b := by
  unfold envelope
  gcongr

-- `envelope_le` (for `z ≤ 1`) and `envelope_real` (for `0 ≤ z`) already exist: Work/Block/WHT.lean:26, :31.

lemma envelope_mono_expL3945 {z z' : ℝ} (h : z ≤ z') (k : ℕ) : envelope z k ≤ envelope z' k := by
  unfold envelope
  exact Nat.ceil_le_ceil (Real.rpow_le_rpow_of_exponent_le (by simp) h)

/-- Natural envelope at our exponent, in the place of OpenAI's `hills` (TensorSaving.lean:114). -/
def hillsL3945 (k : ℕ) := Nat.ceil (((k:ℝ)+1)^alphaL3945)

lemma hillsL3945_eq_envelope : hillsL3945 = envelope alphaL3945 := rfl

lemma hillsL3945_pos (k : ℕ) : 1≤hillsL3945 k := envelope_pos alphaL3945 k

lemma hillsL3945_mono {a b : ℕ} (h : a≤b) : hillsL3945 a ≤ hillsL3945 b := envelope_monoL3945 alphaL3945 alphaL3945_pos.le h

lemma hillsL3945_le (k : ℕ) : hillsL3945 k ≤ k+1 := envelope_le alphaL3945 alphaL3945_lt.le k

lemma hillsL3945_real (k : ℕ) : (hillsL3945 k:ℝ) ≤ 2*((k:ℝ)+1)^alphaL3945 := envelope_real alphaL3945 alphaL3945_pos.le k

/-! ## 3. The kernel program at `alphaL3945` -/

namespace SeamL3945
open Binary Matrix Finset RAM RAM.Ty
universe U

/-- **Kernel program at `alphaL3945 = 1 - 1750110901/10^12`**: every colour, both modes, every batch of inputs. -/
theorem engine_L3945 (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ) (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope alphaL3945 (k i)) :=
  MX.L3945.EngineStmt.lift MX.L3945.engine cl m k v

end SeamL3945

/-! ## 4. THE SEAM -/

namespace RAM
open Binary Matrix Ty Finset
universe U

/-- **THE SEAM.**  OpenAI's `hills_program` (TensorProgram.lean:95) word for word, with `hillsL3945`
(exponent `1 - 1750110901/10^12`) in the place of `hills` (exponent `1 - 2/10^11`): the kernel program `SeamL3945.engine_L3945`, for every colour,
both modes and every batch of inputs, in `2^k * hillsL3945 k` operations. -/
theorem hillsL3945_program (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*hillsL3945 (k i)) :=
  SeamL3945.engine_L3945 cl m k v

/-- **General exponent**: the same at every exponent `z ≥ alphaL3945`, envelope `⌈(k+1)^z⌉`. -/
theorem envelope_program_geL3945 (z : ℝ) (hz : alphaL3945 ≤ z) (cl : Paint) (m : Bool) {ι : Type U} (k : ι→ℕ)
    (v : ∀ i, Bits (k i) → ℂ) :
    Can m (fun i => 2^k i) (simIn cl) (bundle cl)
      (fun i => givenBits cl (k i) (v i)) (fun i => (bits (k i)).tape (ripple (k i) (v i)))
      (fun i => 2^k i*envelope z (k i)) :=
  (hillsL3945_program cl m k v).mono fun i => Nat.mul_le_mul_left _ (envelope_mono_expL3945 hz (k i))

end RAM

/-! ## 5. Number facts for the copy of `Main.lean` -/

namespace SeamL3945

lemma alphaL3945_lt_alpha : alphaL3945 < alpha := by norm_num [alphaL3945, alpha]

/-- for `Skies.alpha_theta` (Main.lean:39): below the paper's exponent. -/
lemma alphaL3945_theta : alphaL3945 < theta := alphaL3945_lt_alpha.trans Skies.alpha_theta

/-- for `Skies.decimal_range` (Main.lean:59). -/
lemma alphaL3945_decimal : alphaL3945 < decimalExponent ∧ decimalExponent < 1 := by
  norm_num [decimalExponent, alphaL3945]

/-- Target exponent of the final Fourier statement: strictly above `alphaL3945`, so that the
`(log log n)^2` factor of the reduction is absorbed. -/
def targetExponentL3945 : ℝ := 1 - 17501109/(10:ℝ)^10
/-- Fallback exponent. -/
def fallbackExponentL3945 : ℝ := 1 - 102210/(10:ℝ)^8

lemma alphaL3945_lt_target : alphaL3945 < targetExponentL3945 := by norm_num [alphaL3945, targetExponentL3945]
lemma alphaL3945_lt_fallback : alphaL3945 < fallbackExponentL3945 := by norm_num [alphaL3945, fallbackExponentL3945]
lemma target_lt_fallbackL3945 : targetExponentL3945 < fallbackExponentL3945 := by
  norm_num [targetExponentL3945, fallbackExponentL3945]
lemma target_posL3945 : 0 < targetExponentL3945 := by norm_num [targetExponentL3945]
lemma target_lt_oneL3945 : targetExponentL3945 < 1 := by norm_num [targetExponentL3945]
lemma fallback_lt_oneL3945 : fallbackExponentL3945 < 1 := by norm_num [fallbackExponentL3945]
lemma target_lt_decimalL3945 : targetExponentL3945 < decimalExponent := by
  norm_num [targetExponentL3945, decimalExponent]
lemma fallback_lt_decimalL3945 : fallbackExponentL3945 < decimalExponent := by
  norm_num [fallbackExponentL3945, decimalExponent]
lemma target_lt_thetaL3945 : targetExponentL3945 < theta :=
  (show targetExponentL3945 < alpha by norm_num [targetExponentL3945, alpha]).trans Skies.alpha_theta
lemma fallback_lt_thetaL3945 : fallbackExponentL3945 < theta :=
  (show fallbackExponentL3945 < alpha by norm_num [fallbackExponentL3945, alpha]).trans Skies.alpha_theta

end SeamL3945
