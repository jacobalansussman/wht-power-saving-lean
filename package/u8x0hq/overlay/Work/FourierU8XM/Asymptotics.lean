  refine hh.trans ?_
  unfold harvestN silo; push_cast
  have hg := stack_limU8XM n N hn h hk ht
  calc
    _ ≤ 8*(16*(14*TmU8XM n))^2 := by gcongr; linarith
    _ ≤ _ := by nlinarith [sq_nonneg (TmU8XM n)]

lemma order_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1 ≤ TmU8XM n) (hu : 1 ≤ QmU8XM n) :
    (orderE N:ℝ) ≤ 3*10^6 * QmU8XM n := by
  have H := log_le_log (by positivity : 0<(2:ℝ)^orderE N) (order_pow_limU8XM n N hn h hk ht)
  have he : 0<TmU8XM n := by linarith
  rw [log_pow,log_mul (by norm_num) (by positivity),log_pow,log_pow] at H
  have H4 := log_le_sub_one_of_pos (show 0 < (10:ℝ) by norm_num)
  unfold QmU8XM at *
  have h0 : 0 ≤ (orderE N:ℝ) := by positivity
  push_cast at H
  nlinarith [log2_minU8XM]

lemma score_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1 ≤ TmU8XM n) (hu : 1 ≤ QmU8XM n) :
