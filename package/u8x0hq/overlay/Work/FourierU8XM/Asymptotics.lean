abbrev TmU8XM (n : ℕ) : ℝ := log (n:ℝ)
abbrev QmU8XM (n : ℕ) : ℝ := log (TmU8XM n)

lemma TtopU8XM : Tendsto TmU8XM atTop atTop := Real.tendsto_log_atTop.comp tendsto_natCast_atTop_atTop
lemma QtopU8XM : Tendsto QmU8XM atTop atTop := Real.tendsto_log_atTop.comp TtopU8XM
lemma log2_minU8XM : 2/3 ≤ log (2:ℝ) := by
  have hh := le_log_one_add_of_nonneg (show (0:ℝ)≤1 by norm_num)
  norm_num at *
  exact hh

-- n is problem size, N allowed between n and 2n
lemma stack_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1≤TmU8XM n) :
    (stackN N:ℝ) ≤ 10 * TmU8XM n := by
  let k := Nat.log 2 (2*N)
  have H : 2^k ≤ 2*N := Nat.pow_log_le_self _ (by omega)
  have H0 : 2^k ≤ 4*n := by omega
  have he : 0<(n:ℝ) := by exact_mod_cast hn
  have HH := log_le_log (by positivity : 0<(2:ℝ)^k)
    (show (2:ℝ)^k ≤ 4*n by exact_mod_cast H0)
  rw [log_pow,log_mul (by norm_num) he.ne'] at HH
  have H4 := log_le_sub_one_of_pos (show (0:ℝ)<4 by norm_num)
  change (((k+1:ℕ):ℝ)) ≤ _
  push_cast
  unfold TmU8XM at *
  nlinarith [log2_minU8XM,show 0≤(k:ℝ) by positivity]

lemma order_pow_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1 ≤ TmU8XM n) :
    (2:ℝ)^orderE N ≤ 10^6*TmU8XM n^2 := by
