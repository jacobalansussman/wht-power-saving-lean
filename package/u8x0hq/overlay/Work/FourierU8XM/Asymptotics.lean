  have H := order_limU8XM n N hn h hk ht hu
  have hk : (score (orderE N):ℝ) ≤ 20000000*((orderE N:ℝ)+1)^2+7 := by
    exact_mod_cast score_le (orderE N)
  calc
    _ ≤ (20000000*((orderE N:ℝ)+1)^2+7)+1 := by gcongr
    _ ≤ (20000000*(4*10^6*QmU8XM n)^2+7)+1 := by gcongr; linarith
    _ ≤ _ := by nlinarith

lemma hills_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1 ≤ TmU8XM n) :
    (hillsU8XM (barge N).l:ℝ) ≤ 100*TmU8XM n^alphaU8XM := by
  have he : 0<TmU8XM n := by linarith
  have H := stack_limU8XM n N hn h hk ht
  have G : ((barge N).l:ℝ) ≤ stackN N := by
    exact_mod_cast (barge_spec N (lt_of_lt_of_le hn h)).count
  have hg := alphaU8XM_pos
  refine (hillsU8XM_real _).trans ?_
  calc
    _ ≤ 2*(11*TmU8XM n)^alphaU8XM := by gcongr; linarith
    _ = 2*(11^alphaU8XM*TmU8XM n^alphaU8XM) := by rw [mul_rpow (by norm_num) he.le]
    _ ≤ 2*(11^(1:ℝ)*TmU8XM n^alphaU8XM) := by gcongr <;> first | exact alphaU8XM_lt.le | norm_num
    _ ≤ _ := by
      rw [rpow_one]
      have hTT : 0 < TmU8XM n^alphaU8XM := by positivity
      linarith

def flightU8XM (n : ℕ) := (n:ℝ)*(TmU8XM n)^alphaU8XM*QmU8XM n^2

lemma leg_limU8XM (n N : ℕ) (hn : 0<n) (h : n≤N) (hk : N ≤ 2*n) (ht : 1 ≤ TmU8XM n) (hu : 1 ≤ QmU8XM n) :
    (legU8XM N:ℝ) ≤ 10^40*flightU8XM n := by
  have hg : (barge N).vol ≤ 8*n := by
    have hh := (barge_spec N (by omega)).upper
    omega
  have hh : ((barge N).vol:ℝ) ≤ 8*n := by exact_mod_cast hg
  have hT : 0 < TmU8XM n := by linarith
  unfold legU8XM; push_cast
  calc
    _ ≤ (10^32 * QmU8XM n^2)*((8*n)*(100*TmU8XM n^alphaU8XM)) :=
      mul_le_mul (score_limU8XM n N hn h hk ht hu)
        (mul_le_mul hh (hills_limU8XM n N hn h hk ht) (by positivity) (by positivity))
        (by positivity) (by positivity)
    _ = 8*100*10^32*flightU8XM n := by unfold flightU8XM; ring
    _ ≤ _ := by
      have hh : 0 ≤ flightU8XM n := by unfold flightU8XM; positivity
      gcongr; norm_num

lemma flight_bigU8XM (n : ℕ) (ht : 1 ≤ TmU8XM n) (hu : 1 ≤ QmU8XM n) :
    (n:ℝ) ≤ flightU8XM n := by
  have H := Real.one_le_rpow ht alphaU8XM_pos.le
  unfold flightU8XM
  calc
    (n:ℝ) = n*1*1 := by ring
    _ ≤ _ := by gcongr; nlinarith

-- little o fournishes eventual caps.
lemma dwarfU8XM {v : ℕ→ℝ} (h : Tendsto v atTop atTop) (d : ℕ) {p c : ℝ} (hp : 0<p) (hc : 0<c) :
    ∀ᶠ n in atTop, log (v n)^d ≤ c*v n^p := by
  have H := (isLittleO_log_rpow_rpow_atTop (d:ℝ) hp).comp_tendsto h
  have hg := H.def hc
  filter_upwards [hg,h.eventually_ge_atTop 1] with n hn he
  have he' : 0<v n := by linarith
  change ‖log (v n)^(d:ℝ)‖ ≤ c*‖v n^p‖ at hn
  rw [rpow_natCast,Real.norm_of_nonneg (pow_nonneg (Real.log_nonneg he) _),
    Real.norm_of_nonneg (by positivity)] at hn
  exact hn

variable {N : ℕ→ℕ}
-- initial branch disappears
lemma docks_evU8XM (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) :
    ∀ᶠ n in atTop, Ports (N n) := by
  have H := dwarfU8XM (v:=fun n => (n:ℝ)) tendsto_natCast_atTop_atTop 2
    (c:=1/10^6) (p:=1) (by norm_num) (by norm_num)
  filter_upwards [H,eventually_gt_atTop 0,TtopU8XM.eventually_ge_atTop 1] with n hh hn ht
  rw [rpow_one] at hh
  have hh' : (TmU8XM n)^2 ≤ 1/10^6*n := hh
  have hh1 := order_pow_limU8XM n (N n) hn (h n).1 (h n).2 ht
  have hh2 : (2:ℝ)^(orderE (N n)) ≤ n := by linarith
  exact (show 2^orderE (N n) ≤ n by exact_mod_cast hh2).trans (h n).1

lemma polylog_evU8XM (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (d : ℕ) :
    ∀ᶠ n in atTop, ((stackN (N n):ℝ)+2)^d ≤ n := by
  have h0 : 0< (12:ℝ)^d := by positivity
  have H := dwarfU8XM (v:=fun n => (n:ℝ)) tendsto_natCast_atTop_atTop d
    (c:=((12:ℝ)^d)⁻¹) (p:=1) (by norm_num) (by positivity)
  filter_upwards [H,eventually_gt_atTop 0,TtopU8XM.eventually_ge_atTop 1] with n hh hn ht
  rw [rpow_one] at hh
  have hh' : (TmU8XM n)^d ≤ ((12:ℝ)^d)⁻¹*n := hh
  have hh1 := stack_limU8XM n (N n) hn (h n).1 (h n).2 ht
  calc
    _ ≤ (12*TmU8XM n)^d := by gcongr; linarith
    _ ≤ _ := by
      rw [mul_pow]
      calc
        _ ≤ _ := mul_le_mul_of_nonneg_left hh' h0.le
        _ = _ := by rw [← mul_assoc,mul_inv_cancel₀ h0.ne',one_mul]

lemma wind_evU8XM (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (d : ℕ) :
    ∀ᶠ n in atTop,(fairwindU8XM d (N n):ℝ)+1 ≤ 10^41*flightU8XM n := by
  filter_upwards [docks_evU8XM h,polylog_evU8XM h d,eventually_gt_atTop 0,TtopU8XM.eventually_ge_atTop 1,
    QtopU8XM.eventually_ge_atTop 1] with n hh hk hn ht hu
  unfold fairwindU8XM Bench.surfU8XM
  rw [ite_eq_left hh,Nat.add_zero]
  push_cast
  have hp := leg_limU8XM n (N n) hn (h n).1 (h n).2 ht hu
  have he := flight_bigU8XM n ht hu
  have he' : 1≤(n:ℝ) := by exact_mod_cast hn
  have hx : (N n:ℝ) ≤ 2*n := by exact_mod_cast (h n).2
  linarith

lemma lunch_bigU8XM (a b : RationU8XM) (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) :
    (fun n : ℕ => (lunchU8XM a b N n:ℝ)) =O[atTop] flightU8XM := by
  let W := lunchU8XM a b N
  refine isBigO_iff.mpr ⟨(a.c:ℝ)*10^41+1+(b.c:ℝ)*10^41,?_⟩
  filter_upwards [wind_evU8XM h a.d,wind_evU8XM h b.d,eventually_gt_atTop 0,TtopU8XM.eventually_ge_atTop 1,
    QtopU8XM.eventually_ge_atTop 1] with n hh hk hn ht hu
  have he := flight_bigU8XM n ht hu
  have h1 : 1≤(n:ℝ) := by exact_mod_cast hn
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by linarith)]
  unfold lunchU8XM calorieU8XM
  push_cast; simp only [add_mul,one_mul,mul_assoc]
  gcongr
  exact h1.trans he

