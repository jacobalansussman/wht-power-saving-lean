namespace OAI

namespace PowerSaving
noncomputable section
open RAM RAM.Ty Filter Asymptotics

def decimalExponentU8X0 : ℝ := 1 - 13928618/(10^(10:ℕ))

def decimalTimeU8X0 (n : ℕ) : ℝ := (n:ℝ) * (Real.log (n:ℝ)) ^ decimalExponentU8X0

/-- Thm 1 (intro main) and decimal corollary estimates. -/
def TimeBoundsU8X0 (W : ℕ → ℕ) : Prop :=
  let W' := fun n : ℕ => (W n : ℝ)
  W' =O[atTop] paperTime ∧ W' =O[atTop] decimalTimeU8X0 ∧ W' =o[atTop] nlogn

def DFTGoalU8X0 : Prop := ∃ order solve W, DFTProgram order solve W ∧ TimeBoundsU8X0 W

def ConvGoalU8X0 : Prop := ∃ order solve W, ConvProgram order solve W ∧ TimeBoundsU8X0 W

end
