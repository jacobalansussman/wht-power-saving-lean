namespace OAI

/-!
Exact uniform Fourier transforms and convolution.

The construction formalizes the exact arithmetic algorithms of
*An explicit power saving for the exact discrete Fourier transform* (OpenAI).
The finite phase network originates in the complex construction of
*Integer multiplication below n log n*.

`transform_mainU8X0` and `convolution_mainU8X0` give fixed finite RAM programs, including
preparation and index work, polynomial storage bounds, and a canonical root whose
order is computed from the input length. Each includes the paper exponent, decimal
power saving, and little-o bound. The `_order` variants also specify the root order.

The implementation uses a smaller concrete tensor network (32 binary coordinates
per factor, 4060 triples, and a `2^50` role envelope) with a stronger saving that
implies the stated paper constants. The general rational-algebra extraction,
symbolic certificate search, circuit printer, and bounded-printer uniformization
from the synthesis appendix are outside this formalization.
-/
namespace PowerSaving
open RAM Bench Selection Filter Asymptotics Real
noncomputable section
namespace Skies

lemma multiplier_rangeU8X0 : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltU8X0 : theta < 1 := by
  have h := multiplier_rangeU8X0
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaU8X0 : alphaU8X0 < theta := by
  let d : ℝ := 13928619/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeU8X0.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minU8X0
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeU8X0 : alphaU8X0 < decimalExponentU8X0 ∧ decimalExponentU8X0 < 1 := by
  norm_num [decimalExponentU8X0,alphaU8X0]

def speedU8X0 (v : ℝ) (n : ℕ) := (n:ℝ)*(TmU8X0 n)^v

lemma flight_littleU8X0 {v : ℝ} (h : alphaU8X0 < v) :
    flightU8X0 =o[atTop] speedU8X0 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8X0.eventually_ge_atTop 1,dwarfU8X0 TtopU8X0 2
    (p:=v-alphaU8X0) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8X0 n := by linarith
  change ‖(n:ℝ)*TmU8X0 n^alphaU8X0*QmU8X0 n^2‖ ≤ c*‖(n:ℝ)*TmU8X0 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmU8X0 n^alphaU8X0)*(c*TmU8X0 n^(v-alphaU8X0)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmU8X0 n^alphaU8X0*TmU8X0 n^(v-alphaU8X0))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaU8X0 + (v-alphaU8X0)=v by ring] -- a+(v-a)

lemma speed_littleU8X0 {u v : ℝ} (h : u < v) :
    speedU8X0 u =o[atTop] speedU8X0 v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8X0.eventually_ge_atTop 1,dwarfU8X0 TtopU8X0 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8X0 n := by linarith
  change ‖(n:ℝ)*TmU8X0 n^u‖ ≤ c*‖(n:ℝ)*TmU8X0 n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmU8X0 n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmU8X0 n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmU8X0 n^u)*(c*TmU8X0 n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmU8X0 n^u*TmU8X0 n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleU8X0 : decimalTimeU8X0 =o[atTop] nlogn := by
  have H := speed_littleU8X0 decimal_rangeU8X0.2
  have h : speedU8X0 1 = nlogn := funext fun n => by rw [speedU8X0,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperU8X0 : speedU8X0 theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopU8X0.eventually_ge_atTop 1,QtopU8X0.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmU8X0 n := by linarith
  have he' : 0<QmU8X0 n := by linarith
  change ‖(n:ℝ)*TmU8X0 n^theta‖ ≤ 1*‖(n:ℝ)*TmU8X0 n^theta*QmU8X0 n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltU8X0])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundU8X0 {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationU8X0) :
    TimeBoundsU8X0 (lunchU8X0 a b N) := by
  have H := lunch_bigU8X0 a b h
  have hp := H.trans_isLittleO (flight_littleU8X0 alpha_thetaU8X0)
  have hd := H.trans_isLittleO (flight_littleU8X0 decimal_rangeU8X0.1)
  have ht : (fun n => (lunchU8X0 a b N n:ℝ)) =O[atTop] decimalTimeU8X0 := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperU8X0,ht,ht.trans_isLittleO decimal_littleU8X0⟩

end Skies

/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderU8X0 : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsU8X0 W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneU8X0
  exact ⟨o,s,lunchU8X0 a b id,hp,Skies.time_boundU8X0 (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderU8X0 : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsU8X0 W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothU8X0
  have h (n : ℕ) : n ≤ stretchU8X0 n ∧ stretchU8X0 n ≤ 2*n := by unfold stretchU8X0; omega
  exact ⟨o,s,lunchU8X0 a b stretchU8X0,hp,Skies.time_boundU8X0 h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posU8X0 hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 13928618/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentU8X0 = 1 - 13928618/10^10`
(Work/FourierU8X0/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_U8X0x`: both
follow from one kernel program, `RAM.hillsU8X0_program` (Work/FourierU8X0/Seam.lean). -/
theorem transform_mainU8X0 : DFTGoalU8X0 :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderU8X0
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainU8X0 : ConvGoalU8X0 :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderU8X0
  ⟨o,s,W,h,g⟩

