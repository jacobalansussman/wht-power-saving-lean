lemma multiplier_rangeU8XMHH : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltU8XMHH : theta < 1 := by
  have h := multiplier_rangeU8XMHH
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaU8XMHH : alphaU8XMHH < theta := by
  let d : ℝ := 16197706/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeU8XMHH.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minU8XMHH
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeU8XMHH : alphaU8XMHH < decimalExponentU8XMHH ∧ decimalExponentU8XMHH < 1 := by
  norm_num [decimalExponentU8XMHH,alphaU8XMHH]

def speedU8XMHH (v : ℝ) (n : ℕ) := (n:ℝ)*(TmU8XMHH n)^v

lemma flight_littleU8XMHH {v : ℝ} (h : alphaU8XMHH < v) :
    flightU8XMHH =o[atTop] speedU8XMHH v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8XMHH.eventually_ge_atTop 1,dwarfU8XMHH TtopU8XMHH 2
    (p:=v-alphaU8XMHH) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8XMHH n := by linarith
  change ‖(n:ℝ)*TmU8XMHH n^alphaU8XMHH*QmU8XMHH n^2‖ ≤ c*‖(n:ℝ)*TmU8XMHH n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmU8XMHH n^alphaU8XMHH)*(c*TmU8XMHH n^(v-alphaU8XMHH)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmU8XMHH n^alphaU8XMHH*TmU8XMHH n^(v-alphaU8XMHH))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaU8XMHH + (v-alphaU8XMHH)=v by ring] -- a+(v-a)

lemma speed_littleU8XMHH {u v : ℝ} (h : u < v) :
    speedU8XMHH u =o[atTop] speedU8XMHH v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopU8XMHH.eventually_ge_atTop 1,dwarfU8XMHH TtopU8XMHH 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmU8XMHH n := by linarith
  change ‖(n:ℝ)*TmU8XMHH n^u‖ ≤ c*‖(n:ℝ)*TmU8XMHH n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmU8XMHH n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmU8XMHH n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmU8XMHH n^u)*(c*TmU8XMHH n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmU8XMHH n^u*TmU8XMHH n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleU8XMHH : decimalTimeU8XMHH =o[atTop] nlogn := by
  have H := speed_littleU8XMHH decimal_rangeU8XMHH.2
  have h : speedU8XMHH 1 = nlogn := funext fun n => by rw [speedU8XMHH,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperU8XMHH : speedU8XMHH theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopU8XMHH.eventually_ge_atTop 1,QtopU8XMHH.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmU8XMHH n := by linarith
  have he' : 0<QmU8XMHH n := by linarith
  change ‖(n:ℝ)*TmU8XMHH n^theta‖ ≤ 1*‖(n:ℝ)*TmU8XMHH n^theta*QmU8XMHH n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltU8XMHH])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundU8XMHH {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationU8XMHH) :
    TimeBoundsU8XMHH (lunchU8XMHH a b N) := by
  have H := lunch_bigU8XMHH a b h
  have hp := H.trans_isLittleO (flight_littleU8XMHH alpha_thetaU8XMHH)
  have hd := H.trans_isLittleO (flight_littleU8XMHH decimal_rangeU8XMHH.1)
  have ht : (fun n => (lunchU8XMHH a b N n:ℝ)) =O[atTop] decimalTimeU8XMHH := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperU8XMHH,ht,ht.trans_isLittleO decimal_littleU8XMHH⟩

