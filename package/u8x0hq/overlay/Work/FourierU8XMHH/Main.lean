/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderU8XMHH : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsU8XMHH W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneU8XMHH
  exact ⟨o,s,lunchU8XMHH a b id,hp,Skies.time_boundU8XMHH (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderU8XMHH : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsU8XMHH W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothU8XMHH
  have h (n : ℕ) : n ≤ stretchU8XMHH n ∧ stretchU8XMHH n ≤ 2*n := by unfold stretchU8XMHH; omega
  exact ⟨o,s,lunchU8XMHH a b stretchU8XMHH,hp,Skies.time_boundU8XMHH h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posU8XMHH hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 16197705/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentU8XMHH = 1 - 16197705/10^10`
(Work/FourierU8XMHH/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_U8XMHHx`: both
follow from one kernel program, `RAM.hillsU8XMHH_program` (Work/FourierU8XMHH/Seam.lean). -/
theorem transform_mainU8XMHH : DFTGoalU8XMHH :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderU8XMHH
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainU8XMHH : ConvGoalU8XMHH :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderU8XMHH
  ⟨o,s,W,h,g⟩

