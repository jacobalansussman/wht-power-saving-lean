    _ ≤ (2*n)*(2*n) := Nat.mul_le_mul hh hh
    _ = n^2*4 := by ring
    _ ≤ n^2*(8*n) := Nat.mul_le_mul_left _ (by omega)
    _ = 8*n^3 := by ring

lemma ladeGrainU8XMHH {X : ι→Cart} {e : ι→ℕ}
