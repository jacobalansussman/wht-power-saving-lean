abbrev shiftTyU8XMHH := p w (p sc sc)
def shiftPU8XMHH (n : ℕ) (x : ℂ) : ℕ→T shiftTyU8XMHH
  | 0 => (n,x,1)
  | j+1 =>
    let (s,u,b) := shiftPU8XMHH n x j
    (s/2,u*u, if s%2=0 then b else b*u)

namespace shiftPU8XMHH
lemma stepP (n : ℕ) (x : ℂ) (j : ℕ) :
    shiftPU8XMHH n x (j+1)=((shiftPU8XMHH n x j).1/2,(shiftPU8XMHH n x j).2.1*(shiftPU8XMHH n x j).2.1,
      if (shiftPU8XMHH n x j).1%2=0 then (shiftPU8XMHH n x j).2.2
      else (shiftPU8XMHH n x j).2.2*(shiftPU8XMHH n x j).2.1) := rfl

lemma real (n : ℕ) (x : ℂ) (j : ℕ) :
    (shiftPU8XMHH n x j).2.2 * (shiftPU8XMHH n x j).2.1^(shiftPU8XMHH n x j).1=x^n := by
  induction j with
  | zero => exact one_mul _
  | succ j ih =>
    let s : ℕ := (shiftPU8XMHH n x j).1
    let a := (shiftPU8XMHH n x j).2.1
    let b := (shiftPU8XMHH n x j).2.2
    rw [stepP]; rw [← ih]
    change (if s%2=0 then b else b*a)*(a*a)^(s/2)=b*a^s
    rw [← pow_two,← pow_mul]
    split
    · rename_i H; rw [show 2*(s/2)=s by omega]
    · rename_i H; rw [mul_assoc,show a * a ^ (2*(s/2)) = a^s by
        simpa only [pow_succ'] using
          (show a^(2*(s/2)+1)=a^s by rw [show 2*(s/2)+1=s by omega])]
lemma countP (n : ℕ) (x : ℂ) (j : ℕ) :
    (shiftPU8XMHH n x j).1=n/2^j := by
  induction j with
  | zero => simp [shiftPU8XMHH]
  | succ j ih => rw [stepP]; simp [ih,Nat.div_div_eq_div_mul,pow_succ]

lemma endP (n : ℕ) (x : ℂ) (j : ℕ) (h : n<2^j) :
    (shiftPU8XMHH n x j).2.2=x^n := by
  simpa only [countP, Nat.div_eq_of_lt h, pow_zero,mul_one] using real n x j
end shiftPU8XMHH

lemma halvePU8XMHH (h : b.Grain S k) (g : b.Grain S n) (hs : Small S n)
    (hh : ∀ i,k i<2^n i) {x : ι→ℂ} (hp : b.Dry S sc x) :
    b.Dry S sc fun i => x i^k i := by
  let V (i : ι) (j) := shiftPU8XMHH (k i) (x i) j
  have ht := Dry.token b n S V (t:=shiftTyU8XMHH)
  have hk : (b.climbs n shiftTyU8XMHH V).Grain (fun i => S i.i) fun i => (V i.i i.j).1 :=
    ⟨ht.fst,(h.small.reindex _).mono fun i => by
      simp only [V,shiftPU8XMHH.countP]; apply Nat.div_le_self⟩
  have hx := ht.snd.fst
  have hy := ht.snd.snd
  have HU := cycleG g hs V (h.dry.pair (hp.pair Dry.one))
    ((hk.div (Grain.wc 2)).dry.pair ((hx.mul hx).pair
      ((hk.residue (Grain.wc 2)).dry.branch hy (hy.mul hx))))
  exact HU.snd.snd.congr fun i => shiftPU8XMHH.endP _ _ _ (hh i)

