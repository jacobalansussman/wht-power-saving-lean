  rw [h.stack_eq] at hh
  omega

def layersPU8XMHH (S : ℕ) : ℕ := 3*S+4
lemma layersGU8XMHH (h : b.Neaps S n) :
    b.Grain S fun i => layersPU8XMHH (S i) :=
