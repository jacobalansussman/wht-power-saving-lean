lemma layersSU8XMHH (S : ι→ℕ) : Small S fun i => layersPU8XMHH (S i) :=
  ((Small.const _ 3).mul (Small.self S)).add (Small.const _ 4)
lemma layersBoundU8XMHH (h : b.Neaps S n) (i) :
    8*(n i)^3 < 2^layersPU8XMHH (S i) := by
  have he : 0<n i := h.pos _
  rw [layersPU8XMHH,pow_add,Nat.mul_comm 3,pow_mul]
  calc
    _ ≤ 8*((2^S i)^3) := by gcongr; exact (h.n_ltU8XMHH i).le
    _ < _ := by
      have hh : 0 < (2^S i)^3 := by positivity
      norm_num
      omega

