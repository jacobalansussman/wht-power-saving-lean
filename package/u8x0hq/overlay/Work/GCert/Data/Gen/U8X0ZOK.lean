set_option maxRecDepth 100000
/-! # (key: k-combine) the coverage facts of the zero checks of `GXD.U8X0` and the three exit conditions
Generated by k-combine's generate_local_lean_xz.py (on k-lower's generate_local_lean_x.py; sources mutable).  Bit batches over the light exit list `lel` (125 exits, 7 bits),
one batch per heavy exit (1), 27 chunks of the other non-y registers; all on the y-free twin `GXD.nyRaw raw`. -/
namespace GXD.U8X0
open GXD OAI.PowerSaving

theorem ny_v : (GXD.nyRaw raw).v = 112 := rfl

theorem hbit : ∀ b, b < 7 → ∀ val : Bool, ∃ p pre, (∀ x ∈ pre, (GXD.nyRaw raw).v ≤ x ∧ x < 2 * (GXD.nyRaw raw).v) ∧
    GS.zCheckZX (GXD.nyRaw raw) p (pre ++ GXD.bitB lel b val) (GXD.rowsXS (GXD.nyRaw raw)) = true := by
  intro b hb val
  have h : b = 0 ∨ b = 1 ∨ b = 2 ∨ b = 3 ∨ b = 4 ∨ b = 5 ∨ b = 6 := by omega
  rcases h with rfl | rfl | rfl | rfl | rfl | rfl | rfl <;> cases val
  exacts [⟨_, _, by rw [ny_v]; decide, zb0f⟩, ⟨_, _, by rw [ny_v]; decide, zb0t⟩, ⟨_, _, by rw [ny_v]; decide, zb1f⟩, ⟨_, _, by rw [ny_v]; decide, zb1t⟩, ⟨_, _, by rw [ny_v]; decide, zb2f⟩, ⟨_, _, by rw [ny_v]; decide, zb2t⟩, ⟨_, _, by rw [ny_v]; decide, zb3f⟩, ⟨_, _, by rw [ny_v]; decide, zb3t⟩, ⟨_, _, by rw [ny_v]; decide, zb4f⟩, ⟨_, _, by rw [ny_v]; decide, zb4t⟩, ⟨_, _, by rw [ny_v]; decide, zb5f⟩, ⟨_, _, by rw [ny_v]; decide, zb5t⟩, ⟨_, _, by rw [ny_v]; decide, zb6f⟩, ⟨_, _, by rw [ny_v]; decide, zb6t⟩]

theorem hhv : ∀ e ∈ hel, ∃ p pre, (∀ x ∈ pre, (GXD.nyRaw raw).v ≤ x ∧ x < 2 * (GXD.nyRaw raw).v) ∧
    GS.zCheckZX (GXD.nyRaw raw) p (pre ++ [e]) (GXD.rowsXS (GXD.nyRaw raw)) = true := by
  intro e he
  simp only [hel, List.mem_cons, List.not_mem_nil, or_false] at he
  rcases he with rfl
  exacts [⟨_, _, by rw [ny_v]; decide, zh0⟩]

theorem hch : ∀ l ∈ chunks, ∃ p, GS.zCheckZX (GXD.nyRaw raw) p l el = true := by
  intro l hl
  simp only [chunks, List.mem_cons, List.not_mem_nil, or_false] at hl
  rcases hl with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
  exacts [⟨_, zc0⟩, ⟨_, zc1⟩, ⟨_, zc2⟩, ⟨_, zc3⟩, ⟨_, zc4⟩, ⟨_, zc5⟩, ⟨_, zc6⟩, ⟨_, zc7⟩, ⟨_, zc8⟩, ⟨_, zc9⟩, ⟨_, zc10⟩, ⟨_, zc11⟩, ⟨_, zc12⟩, ⟨_, zc13⟩, ⟨_, zc14⟩, ⟨_, zc15⟩, ⟨_, zc16⟩, ⟨_, zc17⟩, ⟨_, zc18⟩, ⟨_, zc19⟩, ⟨_, zc20⟩, ⟨_, zc21⟩, ⟨_, zc22⟩, ⟨_, zc23⟩, ⟨_, zc24⟩, ⟨_, zc25⟩, ⟨_, zc26⟩]

theorem hcov' : ∀ s, s < 728 → (s < 112 ∨ 224 ≤ s) → GLab.memK s el = false → ∃ l ∈ chunks, s ∈ l := by
  decide +kernel
theorem hdisj : ∀ l ∈ chunks, ∀ s ∈ l, GLab.memK s el = false := by decide +kernel
theorem hlen : lel.length ≤ 2 ^ 7 := by decide +kernel
theorem hel2' : ∀ r ∈ el, 224 ≤ r := by decide +kernel
theorem hlel : ∀ r ∈ lel, GLab.memK r el = true := by decide +kernel
theorem hhel : ∀ r ∈ hel, r ∉ lel := by decide +kernel
theorem hsplit : ∀ r ∈ el, r ∈ lel ∨ r ∈ hel := by decide +kernel

/-- **the three exit conditions** of the certificate (on its own total matrix; sources mutable) -/
theorem exitRC : OAI.PowerSaving.XEX.ExitRows (GLab.exitSet raw el) (GS.MtX raw scalOKZX.hv) ∧
    OAI.PowerSaving.XEX.ExitCols (GLab.exitSet raw el) (GS.MtX raw scalOKZX.hv) ∧
    OAI.PowerSaving.XEX.ExitColsX (GLab.exitSet raw el) (GS.MtX raw scalOKZX.hv) :=
  GXD.exit_of_twinZX raw scalOKZX.hv el (fun x hx => (scalOKZX.addB x hx).2.2.2)
    (GXD.exit_of_zchecksZX (GXD.nyRaw raw) scalOKZX.hv el
      (GXD.twin_hyX raw scalOKZX.hv (fun x hx => (scalOKZX.addB x hx).2.2.2) scalOKZX.hy)
      lel hel 7 chunks hlen (by decide) (fun r hr => hel2' r hr) hlel hhel hsplit hbit hhv hch
      (fun s hs h1 h2 => hcov' s hs h1 h2) hdisj)

end GXD.U8X0
#print axioms GXD.U8X0.exitRC
