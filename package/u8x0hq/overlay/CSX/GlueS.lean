import Work.KMX.GlueXZ
import CSX.ECheckZX
import CSX.ZCheckZX
import CSX.LabelsS

/-!
# fsp-cc (14 Oct 2026): Glue: a checked exit-frame certificate with MUTABLE sources whose split centres may sit on
# SOURCES is an exit-frame invocation package

k-combine's Work/KMX/GlueXZ.lean (on x-mutable's XMut/Glue.lean and k-lower's KLow/GlueX.lean), generated by checked
substitution (`fsp-cc/tools/make_glueS.py`):
* `gscalOfZX`   the gauged scalar half from fsp-cc's `GS.ScalOKZX` (the scatter may read sources) and `GS.eCheckZX`;
* `reg_srcX`    copy `k` reads source `t` only if the retained register of `k` is `t` (`GS.Cxm`);
* `exit_of_zchecksZX`  the three exit conditions on `GS.MtX` from the zero checks `GS.zCheckZX`;
* `glabXOfZS`, `ginvXOfZS`  `CSX.GLabXZS` (Work/CSX/HalvesS.lean) from k-lower's UNCHANGED label check `GLab.ValidX`,
  and the exit-frame package `XEX.GInvX` (the same package type as k-combine's `ginvXOfZ`); `ginvXOfZS_cost`,
  `ginvXOfZS_res`: the same price and bank residual formulas.
k-combine's y-free-twin route (`exit_of_twinZ`) is not generalised here.  No `sorry`.
Credits: k-lower, x-mutable, k-combine, x-exit-lean, Ryan Shea / DFT Bridge3 / Nil Mamano, Jacob Sussman.
-/

set_option linter.unusedVariables false
set_option linter.unusedSectionVars false
set_option linter.deprecated false

namespace GXD
open SSC OAI.PowerSaving OAI.PowerSaving.CR OAI.PowerSaving.CB Matrix Finset

section
variable (c : Raw) (hv : 0 < c.v) (el : List Nat)

/-- copy `k` reads source `t` only if the retained register of `k` is `t` -/
theorem reg_srcX (k : Fin c.ret.length) (t : Fin c.v) (h : GS.Cxm c k t ≠ 0) : reg c k = t.val := by
  have h' : (if t.val = (c.ret.getD k.val (0, 0)).1 then (1:ℚ) else 0) ≠ 0 := h
  by_cases e : t.val = (c.ret.getD k.val (0, 0)).1
  · exact e.symm
  · rw [if_neg e] at h'; exact absurd rfl h'

/-- **The three exit conditions from the zero checks, sources mutable, centres on sources or slots.** -/
theorem exit_of_zchecksZX
    (hy : ∀ (q : Fin c.R) (t : Fin c.v), GS.MtX c hv (lS q) (lY t) = 0)
    (lel hel : List Nat) (nb : Nat) (chunks : List (List Nat))
    (hlen : lel.length ≤ 2 ^ nb) (hnb : 1 ≤ nb)
    (hel2 : ∀ r ∈ el, 2 * c.v ≤ r)
    (hlel : ∀ r ∈ lel, GLab.memK r el = true) (hhel : ∀ r ∈ hel, r ∉ lel)
    (hsplit : ∀ r ∈ el, r ∈ lel ∨ r ∈ hel)
    (hbit : ∀ b, b < nb → ∀ val : Bool, ∃ p pre, (∀ x ∈ pre, c.v ≤ x ∧ x < 2 * c.v) ∧
      GS.zCheckZX c p (pre ++ bitB lel b val) (rowsXS c) = true)
    (hhv : ∀ e ∈ hel, ∃ p pre, (∀ x ∈ pre, c.v ≤ x ∧ x < 2 * c.v) ∧
      GS.zCheckZX c p (pre ++ [e]) (rowsXS c) = true)
    (hch : ∀ l ∈ chunks, ∃ p, GS.zCheckZX c p l el = true)
    (hcov : ∀ s, s < 2 * c.v + c.R → (s < c.v ∨ 2 * c.v ≤ s) → GLab.memK s el = false → ∃ l ∈ chunks, s ∈ l)
    (hdisj : ∀ l ∈ chunks, ∀ s ∈ l, GLab.memK s el = false) :
    XEX.ExitRows (GLab.exitSet c el) (GS.MtX c hv) ∧ XEX.ExitCols (GLab.exitSet c el) (GS.MtX c hv) ∧
      XEX.ExitColsX (GLab.exitSet c el) (GS.MtX c hv) := by
  have hE : ∀ e ∈ GLab.exitSet c el, 2 * c.v + e.val ∈ el := fun e he =>
    GLab.memK_sound _ el (Finset.mem_filter.mp he).2
  have slot_ge : ∀ i : GS.Rl c, GS.emb c i ∈ slotsL c → 2 * c.v ≤ GS.emb c i := fun i h =>
    (List.mem_range'_1.mp h).1
  -- a non-exit source register: one chunk
  have viaChunk : ∀ (i j : GS.Rl c), GS.emb c i ∈ el → GLab.memK (GS.emb c j) el = false →
      GS.emb c j < 2 * c.v + c.R → (GS.emb c j < c.v ∨ 2 * c.v ≤ GS.emb c j) → GS.MtX c hv i j = 0 := by
    intro i j hi hj hlt hny
    obtain ⟨l, hl, hjl⟩ := hcov _ hlt hny hj
    obtain ⟨p, hp⟩ := hch l hl
    refine GS.zCheckZX_sound hv hp i j hjl hi (fun h => ?_)
    have h1 := hdisj l hl _ h
    rw [memK_complete _ el hi] at h1
    exact Bool.noConfusion h1
  -- an exit batch with source `j` and a row `i` (an x register or a slot, not a source of the batch)
  have viaBatch : ∀ (i j : GS.Rl c) (pre l : List Nat) (p : GS.SPar), (∀ x ∈ pre, c.v ≤ x ∧ x < 2 * c.v) →
      GS.zCheckZX c p (pre ++ l) (rowsXS c) = true → GS.emb c j ∈ l → GS.emb c i ∈ rowsXS c →
      (GS.emb c i < c.v ∨ 2 * c.v ≤ GS.emb c i) → GS.emb c i ∉ l → GS.MtX c hv i j = 0 := by
    intro i j pre l p hpre hp hj hi hxs hni
    refine GS.zCheckZX_sound hv hp i j (List.mem_append_right _ hj) hi (fun h => ?_)
    rcases List.mem_append.mp h with h | h
    · have := hpre _ h; omega
    · exact hni h
  -- a source exit `s` and a row `i ≠ s` that is an x register or a slot, and not an exit unless `rows` separate
  have sepAny : ∀ (i j : GS.Rl c), GS.emb c j ∈ el → GS.emb c i ∈ rowsXS c →
      (GS.emb c i < c.v ∨ 2 * c.v ≤ GS.emb c i) → GS.emb c i ≠ GS.emb c j → GS.MtX c hv i j = 0 := by
    intro i j hj hi hxs hne
    rcases hsplit _ hj with hjl | hjh
    · by_cases hil : GS.emb c i ∈ lel
      · obtain ⟨b, hb, hjb, hib⟩ := bit_sep lel nb hlen hil hjl hne
        obtain ⟨p, pre, hpre, hp⟩ := hbit b hb _
        exact viaBatch i j pre _ p hpre hp hjb hi hxs hib
      · obtain ⟨p, pre, hpre, hp⟩ := hbit 0 hnb ((lel.idxOf (GS.emb c j)).testBit 0)
        refine viaBatch i j pre _ p hpre hp ?_ hi hxs (fun h => hil (List.mem_filter.mp h).1)
        unfold bitB; exact List.mem_filter.mpr ⟨hjl, by simp⟩
    · obtain ⟨p, pre, hpre, hp⟩ := hhv _ hjh
      exact viaBatch i j pre [GS.emb c j] p hpre hp (List.mem_singleton_self _) hi hxs
        (fun h => hne (List.mem_singleton.mp h))
  refine ⟨fun e he j hj => ?_, fun e he q hq => ?_, fun e he t => ?_⟩
  · have hr := hE e he
    rcases j with ((t|t)|q)
    · have ht : GLab.memK t.val el = false := by
        cases h : GLab.memK t.val el with
        | false => rfl
        | true => have := hel2 _ (GLab.memK_sound _ el h); have := t.isLt; omega
      exact viaChunk (lS e) (lX t) hr ht (show t.val < 2 * c.v + c.R by have := t.isLt; omega)
        (Or.inl (show t.val < c.v from t.isLt))
    · exact hy e t
    · have hqe : q ≠ e := fun h => hj (by rw [h])
      cases h : GLab.memK (2 * c.v + q.val) el with
      | false =>
        exact viaChunk (lS e) (lS q) hr h (show 2 * c.v + q.val < 2 * c.v + c.R by have := q.isLt; omega)
          (Or.inr (show 2 * c.v ≤ 2 * c.v + q.val by omega))
      | true =>
        have hne : 2 * c.v + e.val ≠ 2 * c.v + q.val := fun h' => hqe (Fin.ext (by omega))
        exact sepAny (lS e) (lS q) (GLab.memK_sound _ el h) (mem_rowsXS_slot c (mem_slotsL c e))
          (Or.inr (show 2 * c.v ≤ 2 * c.v + e.val by omega)) hne
  · have hr := hE e he
    have hqe : 2 * c.v + q.val ≠ 2 * c.v + e.val := fun h => hq (Fin.ext (by omega))
    exact sepAny (lS q) (lS e) hr (mem_rowsXS_slot c (mem_slotsL c q))
      (Or.inr (show 2 * c.v ≤ 2 * c.v + q.val by omega)) hqe
  · have hr := hE e he
    have hne : t.val ≠ 2 * c.v + e.val := by have := t.isLt; omega
    exact sepAny (lX t) (lS e) hr (mem_rowsXS_x c t) (Or.inl t.isLt) hne

end

section
variable (c : Raw) (K : GS.ScalOKZX c)
    (es : List (GS.SPar × List Nat)) (he : ∀ e ∈ es, GS.eCheckZX c e.1 e.2 = true)
    (a : GLab.Aux) (el : List Nat) (V : GLab.ValidX c a (es.flatMap Prod.snd) el)
    (hR : XEX.ExitRows (GLab.exitSet c el) (GS.MtX c K.hv)) (hC : XEX.ExitCols (GLab.exitSet c el) (GS.MtX c K.hv))
    (hX : XEX.ExitColsX (GLab.exitSet c el) (GS.MtX c K.hv))

/-- **the gauged mutable-source scalar half, centres on sources or slots** (x-mutable's `gscalOfZ` with `ScalOKZX`,
`eCheckZX`) -/
noncomputable def gscalOfZX : GX.GScalZ (Fin c.v) (Fin c.R) (Fin c.ret.length) where
  toScalZ := K.toScalZ
  gauged := univ.filter (fun q : Fin c.R => 2 * c.v + q.val ∈ es.flatMap Prod.snd)
  hE := fun q hq t => by
    obtain ⟨e, he1, he2⟩ := List.mem_flatMap.mp (Finset.mem_filter.mp hq).2
    exact GS.eCheckZX_sound K.hv (he e he1) q he2 t

theorem gscalOfZX_gauged (q : Fin c.R) :
    q ∈ (gscalOfZX c K es he).gauged ↔ 2 * c.v + q.val ∈ es.flatMap Prod.snd := by
  show q ∈ univ.filter (fun q : Fin c.R => 2 * c.v + q.val ∈ es.flatMap Prod.snd) ↔ _
  simp

theorem reg_slotZX (k : Fin c.ret.length) (q : Fin c.R) (h : (gscalOfZX c K es he).Cc k q ≠ 0) :
    reg c k = 2 * c.v + q.val := by
  have h' : (if 2 * c.v + q.val = (c.ret.getD k.val (0, 0)).1 then (1:ℚ) else 0) ≠ 0 := h
  by_cases e : 2 * c.v + q.val = (c.ret.getD k.val (0, 0)).1
  · exact e.symm
  · rw [if_neg e] at h'; exact absurd rfl h'

/-- the exit label half of a checked exit-frame certificate over its gauged mutable-source scalar half -/
noncomputable def glabXOfZS : CSX.GLabXZS (Fin a.p.h) (gscalOfZX c K es he) :=
  V.glabXZS (gscalOfZX c K es he) (roles c K.hv) GS.toCoef (GS.Cxm c) rfl rfl rfl rfl
    (reg c) (reg_slotZX c K es he) (reg_srcX c) (reg_mem c)
    (fun q hq => (gscalOfZX_gauged c K es he q).mpr hq) hR hC hX

/-- **a checked exit-frame certificate with mutable sources is an exit-frame invocation package** -/
noncomputable def ginvXOfZS : XEX.GInvX (Fin a.p.h) (Fin c.v) (Fin c.R) (Fin c.ret.length) :=
  (glabXOfZS c K es he a el V hR hC hX).inv

/-- its price: Shea's invoice (the tail climbs are part of `rB`) -/
theorem ginvXOfZS_cost (φ : ℕ → ℝ) :
    (ginvXOfZS c K es he a el V hR hC hX).cost φ
      = rcost φ a.rA + (∑ k : Fin c.ret.length, bcost φ (GLab.cdim (a.p.tab.get (a.SA.get (reg c k)))))
        + rcost φ a.rB + rcost φ a.rF := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := V.glabXZS_ranks (gscalOfZX c K es he) (roles c K.hv) GS.toCoef (GS.Cxm c) rfl rfl rfl rfl
    (reg c) (reg_slotZX c K es he) (reg_srcX c) (reg_mem c)
    (fun q hq => (gscalOfZX_gauged c K es he q).mpr hq) hR hC hX
  show CSX.GLabXZS.cost (glabXOfZS c K es he a el V hR hC hX) φ = _
  unfold CSX.GLabXZS.cost
  unfold glabXOfZS
  rw [h1, h2, h3, h4, rcost_nil]
  simp only [h5, add_zero]

/-- its bank residuals -/
theorem ginvXOfZS_res (q : Fin c.R) :
    ((ginvXOfZS c K es he a el V hR hC hX).ex q).dim - ((ginvXOfZS c K es he a el V hR hC hX).ent q).dim
      = Bool.rec (motive := fun _ => Nat) (a.p.h - GLab.cdim (a.p.tab.get (a.S0.get (2 * c.v + q.val))))
          (GLab.cdim (a.p.tab.get (a.SF.get (2 * c.v + q.val)))
            - GLab.cdim (a.p.tab.get (a.S0.get (2 * c.v + q.val))))
          (GLab.memK (2 * c.v + q.val) el) :=
  V.glabXZS_res (gscalOfZX c K es he) (roles c K.hv) GS.toCoef (GS.Cxm c) rfl rfl rfl rfl
    (reg c) (reg_slotZX c K es he) (reg_srcX c) (reg_mem c)
    (fun q hq => (gscalOfZX_gauged c K es he q).mpr hq) hR hC hX q

end

end GXD

