matrix B[4][4];
B[1,1]=(25+25*u(1)+25*u(2)+25*u(3)+25*u(4)+25*u(5)+25*u(6));
B[1,2]=(25+20*u(1)+16*u(2)+7*u(3)+23*u(4)+1*u(5)+24*u(6));
