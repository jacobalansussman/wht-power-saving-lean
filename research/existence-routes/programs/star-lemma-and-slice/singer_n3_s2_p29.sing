B[1,4]=(25+16*u(1)+23*u(2)+24*u(3)+20*u(4)+7*u(5)+1*u(6));
B[2,1]=(25+24*u(1)+1*u(2)+23*u(3)+7*u(4)+16*u(5)+20*u(6));
B[2,2]=(25+25*u(1)+25*u(2)+25*u(3)+25*u(4)+25*u(5)+25*u(6));
